@model IEnumerable<Aquasip.EF.ReviewVote>
@{
    ViewData["Title"] = "ReviewVotes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var oReview = ViewData["Review"] as Aquasip.EF.Review;
}
<h3>List of Votes</h3>
<h4>Title: @oReview.Title</h4>
<h4>Review By: @oReview.Customer.FullName</h4>
<a href="/ReviewVotes/Create?reviewId=@oReview?.ReviewId">Create New Vote</a>
|
<a asp-action="Details" asp-controller="Reviews" asp-route-id="@oReview?.ReviewId">Back to the Review</a>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IsHelpful)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Review)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IsHelpful)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Review.Title)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.VoteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.VoteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.VoteId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


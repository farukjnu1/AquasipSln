@model Aquasip.EF.ReviewVote

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Delete</h3>

<h4>Are you sure you want to delete this?</h4>
<div>
    <h4>ReviewVote</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsHelpful)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsHelpful)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Review)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Review.Title)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="VoteId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        @* <a asp-action="Index">Back to List</a> *@
        <a href="/ReviewVotes/Index?reviewId=@Model?.ReviewId">Back to List</a>
    </form>
</div>

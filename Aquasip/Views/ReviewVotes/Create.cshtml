@model Aquasip.EF.ReviewVote

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var oReview = ViewData["Review"] as Aquasip.EF.Review;
}

<h4>ReviewVote | Create</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ReviewId" class="control-label"></label>
                <input asp-for="ReviewId" type="hidden" />
                <input name="Title" value="@oReview.Title" readonly class="form-control" />
                @* <select asp-for="ReviewId" class="form-control" asp-items="ViewBag.ReviewId" disabled></select> *@
                <span asp-validation-for="ReviewId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                @* <input asp-for="CustomerId" type="hidden" /> *@
                @* <input name="FullName" value="@oReview.Customer.FullName" readonly class="form-control" /> *@
                <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsHelpful" /> @Html.DisplayNameFor(model => model.IsHelpful)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/ReviewVotes/Index?reviewId=@Model?.ReviewId">Back to List</a>
</div>


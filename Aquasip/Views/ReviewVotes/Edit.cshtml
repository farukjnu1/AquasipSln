@model Aquasip.EF.ReviewVote

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Edit</h3>

<h4>ReviewVote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="VoteId" />
            <div class="form-group">
                <label asp-for="ReviewId" class="control-label"></label>
                <input asp-for="ReviewId" type="hidden" />
                <input name="Title" value="@Model.Review.Title" readonly class="form-control" />
                @* <select asp-for="ReviewId" class="form-control" asp-items="ViewBag.ReviewId" disabled></select> *@
                <span asp-validation-for="ReviewId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                <input asp-for="CustomerId" type="hidden" />
                <input name="FullName" value="@Model.Customer.FullName" readonly class="form-control" />
                @* <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId" disabled></select> *@
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsHelpful" /> @Html.DisplayNameFor(model => model.IsHelpful)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    @* <a asp-action="Index" asp-arout-id="ReviewId">Back to List</a> *@
    <a href="/ReviewVotes/Index?reviewId=@Model?.ReviewId">Back to List</a>
</div>


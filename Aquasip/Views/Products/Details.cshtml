@model Aquasip.Models.ProductVM
@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<h3>Media of Product</h3>
<div class="row">
    <div class="col-6">
        <h3>Create Media</h3>
        <hr />
        <form asp-action="Details" asp-controller="Products" method="post" enctype="multipart/form-data">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ProductCode)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ProductCode)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ProductName)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ProductName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Description)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Description)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Price)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Price)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IsActive)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IsActive)
                </dd>
                <dt>
                    Media
                </dt>
                <dd>
                    <input type="hidden" asp-for="ProductId" />
                    <input type="file" asp-for="MediaFile" style="padding-top:5px" />
                </dd>
            </dl>
            <div>
                <input type="submit" value="Upload" class="btn btn-outline-success" />
            </div>
        </form>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.ProductId">Edit</a> |
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
    <div class="col-6">
        <h3>Details Media</h3>
        <hr />
        <table>
            @foreach (var item in Model.ListProductMedia)
            {
                <tr>
                    <td>
                        <div class="pt-2 pb-2">
                            <img src="@item.FilePath" style="width:250px" />
                        </div>
                    </td>
                    <td>
                        <a asp-action="DeleteMedia" asp-route-id="@item?.ProductMediaId" onclick="return confirm('Are you sure to remove?');">Remove</a>
                    </td>
                </tr>
            }
        </table>
        
    </div>
</div>


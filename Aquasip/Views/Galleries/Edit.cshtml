@model Aquasip.EF.Gallery

@{
    ViewData["Title"] = "Gallery Edit";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Edit Gallery</h3>

<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="Edit" asp-controller="Galleries" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="GalleryId" />
            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <textarea asp-for="Title" class="form-control"></textarea>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Header" class="control-label"></label>
                <textarea asp-for="Header" class="form-control"></textarea>
                <span asp-validation-for="Header" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Body" class="control-label"></label>
                <textarea asp-for="Body" class="form-control"></textarea>
                <span asp-validation-for="Body" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Footer" class="control-label"></label>
                <textarea asp-for="Footer" class="form-control"></textarea>
                <span asp-validation-for="Footer" class="text-danger"></span>
            </div>
            <div class="form-group pt-2">
                <label asp-for="IsActive" class="control-label"></label>
                <select asp-for="IsActive">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
            </div>
            
            
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


@model Aquasip.Models.SalesOrderVM

@{
    ViewData["Title"] = "SO Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    
    decimal totalPaidAmount = 0;
    string? paymentStatus = "undefined";
    totalPaidAmount = Model.CustomerPayments.Where(y=>y.PaymentStatusId == 2).Sum(x => x.PaidAmount);
    paymentStatus = totalPaidAmount < Model.GrandTotal ? "DUE" : "PAID";
    string paymentStatusColor = totalPaidAmount < Model.GrandTotal ? "badge bg-danger" : "badge bg-success";
}

<h3>Sales Order <span class="@paymentStatusColor">@paymentStatus</span></h3>
<div class="row">
    <div class="col-sm-6">
        <h4>Order-Summery</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrderNumber)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.OrderNumber)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.OrderDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.OrderDate)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.SubTotal)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.SubTotal)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.VatPercent) (%)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.VatPercent)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.VatAmount)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.VatAmount)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.DeliveryCharge)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.DeliveryCharge)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.GatewayCharge)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.GatewayCharge)
            </dd>
            <dt class="col-sm-4 text-danger">
                @Html.DisplayNameFor(model => model.GrandTotal)
            </dt>
            <dd class="col-sm-8 text-danger">
                @Html.DisplayFor(model => model.GrandTotal)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.SalesOrderState.OrderStatus)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.SalesOrderState.OrderStatus)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Notes)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Notes)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Customer.FullName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Customer.FullName)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.PaymentMethod.PaymentMethodName)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.PaymentMethod.PaymentMethodName)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ShippingAddress)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ShippingAddress.StreetAddress)
            </dd>
        </dl>
    </div>
    <div class="col-sm-6">
        <h4>Order-Details </h4>
        <hr />
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>
                        <td>@item.UnitPrice</td>
                        <td>@item.Qty</td>
                        <td>@item.TotalPrice</td>
                        <td>
                            @if (item.IsStockUpdated == true)
                            {
                                <a href="javascript:void(0)" title="Received">Received</a>
                            }
                            else
                            {
                                <a href="/StockTransactions/SalesOrderDetail?id=@item.OrderDetailId&referenceToken=@item.ReferenceToken&transactionType=@item.TransactionTypeToken" title="Add to Stocks">Add to Stocks</a>
                            }
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        <h4>
            Customer Payments
            <!-- Button trigger modal -->
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#OpenPayment">
                Open Payment
            </button>
        </h4>
        <hr />
        <table class="table">
            <thead>
                <tr>
                    <th>PaymentDate</th>
                    <th>PaymentStatus</th>
                    <th>PaymentMethod</th>
                    <th style="text-align:right">PaidAmount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CustomerPayments)
                {
                    <tr>
                        <td>@item.PaymentDate</td>
                        <td><a href="/CustomerPayments/Edit/@item.PaymentId">@item.PaymentStatus.PaymentStatus1</a></td>
                        <td>@item.PaymentMethod.PaymentMethodName</td>
                        <td align="right">@item.PaidAmount</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th class="text-success">Payment Total:</th>
                    <th class="text-success" style="text-align:right">@totalPaidAmount</th>
                </tr>
            </tfoot>
        </table>
    </div>

</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrderId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

<!-- Modal -->
<div class="modal fade"
     id="OpenPayment"
     tabindex="-1"
     aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">
                    Payment Information
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="Create" asp-controller="CustomerPayments" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="OrderNumber" class="control-label"></label>
                        <input asp-for="OrderNumber" class="form-control" readonly />
                        <input type="hidden" asp-for="CustomerPayment.OrderId" />
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.PaymentMethodId" class="control-label"></label>
                        <select asp-for="CustomerPayment.PaymentMethodId" class="form-control" asp-items="ViewBag.PaymentMethodId"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.PaymentStatusId" class="control-label"></label>
                        <select asp-for="CustomerPayment.PaymentStatusId" class="form-control" asp-items="ViewBag.PaymentStatusId"></select>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.TransactionNumber" class="control-label"></label>
                        <input asp-for="CustomerPayment.TransactionNumber" class="form-control" required />
                        <span asp-validation-for="CustomerPayment.TransactionNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.PaidAmount" class="control-label"></label>
                        <input asp-for="CustomerPayment.PaidAmount" class="form-control" min="0" required />
                        <span asp-validation-for="CustomerPayment.PaidAmount" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.PaymentDate" class="control-label"></label>
                        <input asp-for="CustomerPayment.PaymentDate" class="form-control" required />
                        <span asp-validation-for="CustomerPayment.PaymentDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPayment.Remarks" class="control-label"></label>
                        <input asp-for="CustomerPayment.Remarks" class="form-control" />
                        <span asp-validation-for="CustomerPayment.Remarks" class="text-danger"></span>
                    </div>
                    <div class="form-group pt-2">
                        <input type="submit" value="Create" class="btn btn-primary" />
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
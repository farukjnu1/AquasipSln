@model IEnumerable<Aquasip.Models.SalesOrderVM>

@{
    ViewData["Title"] = "SOs";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var nOrderStateId = (int?)ViewData["nOrderStateId"];
    var PageSize = (int?)ViewData["PageSize"];
}

<h3>Sales Orders : <a href="/SalesOrders/Create">Bulk Order</a></h3>

<div class="row">
    <div class="col-md-3">
        <input type="hidden" id="nOrderStateId" value="@nOrderStateId" />
        <label for="OrderStateId" class="control-label">Order Status</label>
        <select id="OrderStateId" asp-items="ViewBag.OrderStateId"></select>
    </div>
    <div class="col-md-2">
        <input type="hidden" id="nPageSize" value="@PageSize" />
        <label for="PageSize" class="control-label">Row</label>
        <select id="PageSize">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="500">500</option>
        </select>
    </div>
    <div class="col-md-2">
        <button onclick="search()">Search</button>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>
                @Html.DisplayNameFor(model => model.SalesOrderState.OrderStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrandTotal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer.FullName)
            </th>
            
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderId">Pays</a> |
                <a asp-action="Details" asp-route-id="@item.OrderId">Stocks</a>
            </td>
            <td style="font-weight:bolder;color:@item.SalesOrderState.ColorCode">
                @Html.DisplayFor(modelItem => item.SalesOrderState.OrderStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GrandTotal)
            </td>
            
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.FullName)
            </td>          
        </tr>
}
    </tbody>
</table>
<script>
    // Equivalent to jQuery $(document).ready()
    document.addEventListener("DOMContentLoaded", function () {
        console.log("Document is ready!");
        setSearchValues();
    });
    function setSearchValues(){
        var nPageSize = document.getElementById('nPageSize').value;
        document.getElementById('PageSize').value = nPageSize;
        var nOrderStateId = document.getElementById('nOrderStateId').value;
        document.getElementById('OrderStateId').value = nOrderStateId;
    }
    function search(){
        var OrderStateId = document.getElementById('OrderStateId').value;
        var PageSize = document.getElementById('PageSize').value;
        location.href = '/SalesOrders/Index?OrderStateId='+OrderStateId + '&PageSize=' + PageSize;
    }
</script>

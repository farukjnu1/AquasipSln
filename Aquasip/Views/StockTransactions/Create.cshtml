@model Aquasip.EF.StockTransaction

@{
    ViewData["Title"] = "Stock Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var referenceType = ViewData["ReferenceType"] as Aquasip.Models.ReferenceTypeVM;
    var referenceTypeName = referenceType != null ? referenceType.Name : "undefined";
    var listStock = ViewData["Stocks"] as IEnumerable<Aquasip.Models.StockTransactionVM>;
}

<h3>Create StockTransaction</h3>

<div class="row">
    <div class="col-md-6">
        <h4>Current Order</h4>
        <hr />
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" asp-for="TransactionTypeId" />
            <input type="hidden" asp-for="ReferenceTypeId" />
            <input type="hidden" asp-for="ReferenceId" />
            <input type="hidden" asp-for="IsActive" />
            <div class="form-group">
                <label asp-for="StoreId" class="control-label"></label>
                <select asp-for="StoreId" class="form-control" asp-items="ViewBag.StoreId"></select>
                <span asp-validation-for="StoreId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="TransactionDate" class="control-label">TransactionDate</label>
                <input for="TransactionDate" id="TransactionDate" value="@Model.TransactionDate" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label for="ProductName" class="control-label">Product</label>
                <input type="text" id="ProductName" value="@Model.Product.ProductName" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="UnitCost" class="control-label"></label>
                <input asp-for="UnitCost" class="form-control" readonly />
                <span asp-validation-for="UnitCost" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QtyIn" class="control-label"></label>
                <input asp-for="QtyIn" class="form-control" readonly />
                <span asp-validation-for="QtyIn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QtyOut" class="control-label"></label>
                <input asp-for="QtyOut" class="form-control" readonly />
                <span asp-validation-for="QtyOut" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="ReferenceTypeId" class="control-label">ReferenceType</label>
                <input id="ReferenceTypeId" class="form-control" value="@referenceTypeName" readonly />
            </div>
            @* <div class="form-group">
                <label asp-for="TransactionTypeId" class="control-label"></label>
                <input asp-for="TransactionTypeId" class="form-control" />
                <span asp-validation-for="TransactionTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReferenceId" class="control-label"></label>
                <input asp-for="ReferenceId" class="form-control" />
                <span asp-validation-for="ReferenceId" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-control" />
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>*@ 
            <div class="form-group pt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Current Stock</h4>
        <hr />
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Store</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in listStock)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>
                        <td>@item.Store.StoreName</td>
                        <td>@item.CurrentStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


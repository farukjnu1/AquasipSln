@model Aquasip.Models.ReviewVM

@{
    ViewData["Title"] = "Review Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Review</h3>
<div class="row">
    <div class="col-md-6">
        <h4>Details</h4>
        <hr />
        <form asp-action="Details" asp-controller="Reviews" method="post" enctype="multipart/form-data">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Title)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Title)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.ReviewText)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ReviewText)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Rating)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Rating)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Helpful)
                </dt>
                <dd class="col-sm-10">
                    <a href="/ReviewVotes/Index?reviewId=@Model.ReviewId">@Html.DisplayFor(model => model.Helpful)</a>
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.NotHelpful)
                </dt>
                <dd class="col-sm-10">
                    <a href="/ReviewVotes/Index?reviewId=@Model.ReviewId">@Html.DisplayFor(model => model.NotHelpful)</a>
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IsApproved)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IsApproved)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.CreatedAt)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CreatedAt)
                </dd>
                @* <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.IsDeleted)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.IsDeleted)
                </dd> *@
                <dt class="col-sm-2">
                    Remarks
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.ModerationStatus)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Customer)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Customer.FullName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Product)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Product.ProductName)
                </dd>
                <dt>
                    Media
                </dt>
                <dd>
                    <input type="hidden" asp-for="ReviewId" />
                    <input type="file" asp-for="MediaFile" style="padding-top:5px" />
                </dd>
            </dl>
            <div>
                <input type="submit" value="Upload" class="btn btn-outline-success" />
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Media</h4>
        <hr />
        <table>
            @foreach (var item in Model.ReviewMedia)
            {
                <tr>
                    <td>
                        <div class="pt-2 pb-2">
                            <img src="@item.MediaUrl" style="width:250px" />
                        </div>
                    </td>
                    <td>
                        <a asp-action="DeleteMedia" asp-route-id="@item?.MediaId" onclick="return confirm('Are you sure to remove?');">Remove</a>
                    </td>
                </tr>
            }
        </table>
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ReviewId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

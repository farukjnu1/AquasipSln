@model IEnumerable<Aquasip.EF.PurchaseOrder>

@{
    ViewData["Title"] = "POs";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3>Purchase Orders</h3>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ponumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Podate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Supplier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PurchaseState)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Ponumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Podate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsActive)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.SupplierName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PurchaseState.PurchaseStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PurchaseOrderId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PurchaseOrderId">Pays</a> |
                <a asp-action="Details" asp-route-id="@item.PurchaseOrderId">Stocks</a>
                @* |
                <a asp-action="Delete" asp-route-id="@item.PurchaseOrderId">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>

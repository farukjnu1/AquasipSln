@model Aquasip.Models.ContactMessageVM
@{
    ViewData["Title"] = "AquaSip | Contact";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["contact"];
    var oContact = viewModel.Where(x => x.Slug == "contact").FirstOrDefault() == null ? new PageVM() : viewModel.Where(x => x.Slug == "contact").First();
    var contact = oContact.PageContents.Where(x => x.SlugPageContent == "contact").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oContact.PageContents.Where(x => x.SlugPageContent == "contact").First();

    var map = oContact.PageContents.Where(x => x.SlugPageContent == "map").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                    oContact.PageContents.Where(x => x.SlugPageContent == "map").First();

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() : viewModel.Where(x => x.Slug == "layout").First();
    // var listLayout = oContact.PageContents.Where(x => x.SlugPage == "layout").ToList();

    // var oLocation = layoutPage.PageContents.Where(x => x.SlugPageContent == "location").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    // : layoutPage.PageContents.Where(x => x.SlugPageContent == "location").First();

    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var oEmail = layoutPage.PageContents.Where(x => x.SlugPageContent == "email").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "email").First();

    var oAddress = layoutPage.PageContents.Where(x => x.SlugPageContent == "address").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "address").First();

    var oEmail2 = layoutPage.PageContents.Where(x => x.SlugPageContent == "email_2").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "email_2").First();

    var oMobile = layoutPage.PageContents.Where(x => x.SlugPageContent == "mobile").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "mobile").First();

    var oFacebook = layoutPage.PageContents.Where(x => x.SlugPageContent == "facebook").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "facebook").First();

    var oTwitter = layoutPage.PageContents.Where(x => x.SlugPageContent == "twitter").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "twitter").First();

    var oInstagram = layoutPage.PageContents.Where(x => x.SlugPageContent == "instagram").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "instagram").First();

    var oLinkedin = layoutPage.PageContents.Where(x => x.SlugPageContent == "linkedin").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "linkedin").First();

    var oLogo = layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
     : layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").First();

    // var listQuickLink = layoutPage.PageContents.Where(x => x.SlugPageContent == "quick_links").ToList();
    // var listOurService = layoutPage.PageContents.Where(x => x.SlugPageContent == "our_services").ToList();

    
}
<!-- Navbar & Hero Start -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="/" class="navbar-brand p-0">
            @if (oLogo.IsActive == true)
            {
                <h1 class="text-primary m-0"><img src="@oLogo.FilePath" /></h1>
            }
            else
            {
                <h1 class="text-primary m-0">YOUR-LOGO</h1>
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link">Home</a>
                <a href="/Home/Products" class="nav-item nav-link">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link active">Gallery</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
                <a href="/Home/Review" class="nav-item nav-link">Review</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
            </div>
            <div class="d-none d-xl-flex me-3">
                <div class="d-flex flex-column pe-3 border-end border-primary">
                    <span class="text-body">Get Free Delivery</span>
                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header Start -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Gallery</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active text-primary">Gallery</li>
            </ol>
        </div>
    </div>
    <!-- Header End -->
</div>
<!-- Navbar & Hero End -->


<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->
<!-- Gallery Start -->
@foreach (var item in listGallery)
{
    <div class="container-fluid service bg-light overflow-hidden py-2">
        <div class="container py-2">
            <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px; visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
                <h4 class="text-uppercase text-primary">@item.Title</h4>
                <h1 class="display-3 text-capitalize mb-3">@item.Header</h1>
            </div>
            <div class="row gx-0 gy-4 align-items-center">
                @for (var i = 0; i < item.ListGalleryMedia.Count; i++)
                {
                    var galleryMedia = item.ListGalleryMedia;
                    int dela = (i + 1) * 20;
                    double delas = dela / 100.0;
                    string delays = delas.ToString() + "s";
                    string FilePath = item.ListGalleryMedia.Count > 0 ? item.ListGalleryMedia[0].FilePath : "";
                    string fadeIn = "fadeInUp";
                    fadeIn = i == 0 ? "fadeInLeft" : i == (item.ListGalleryMedia.Count - 1) ? "fadeInRight" : "fadeInUp";
                    <div class="col-lg-6 col-xl-4 wow @fadeIn" data-wow-delay="@delays" style="visibility: visible; animation-delay: @delays; animation-name: @fadeIn;">
                        <div class="bg-transparent">
                            <img src="@galleryMedia[i].FilePath" class="img-fluid w-100" alt="">
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Gallery End -->
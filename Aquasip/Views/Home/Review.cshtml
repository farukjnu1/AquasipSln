<script>
    // Modal Functions
    function openReviewModal() {
      document.getElementById('reviewModal').style.display = 'flex';
    }

    function closeReviewModal() {
      document.getElementById('reviewModal').style.display = 'none';
    }

    // File upload handling
    const fileInput = document.getElementById('attachments');
    const fileList = document.getElementById('fileList');

    fileInput.addEventListener('change', function() {
      fileList.innerHTML = '';
      Array.from(this.files).forEach(file => {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item';
        fileItem.innerHTML = `
          <span class="file-name">${file.name}</span>
          <span class="file-size">${(file.size / 1024).toFixed(2)} KB</span>
        `;
        fileList.appendChild(fileItem);
      });
    });

    // Write review button
    document.querySelector('.write-review-btn').addEventListener('click', openReviewModal);

    // Close modal when clicking overlay
    document.getElementById('reviewModal').addEventListener('click', function(e) {
      if (e.target === this) closeReviewModal();
    });

    // Close modal button
    document.querySelector('.modal-close').addEventListener('click', closeReviewModal);

    // Star rating selector
    const starLabels = document.querySelectorAll('.rating-selector .star-label');
    starLabels.forEach((label, index) => {
      label.addEventListener('click', function() {
        starLabels.forEach((l, i) => {
          if (i <= index) {
            l.classList.add('selected');
          } else {
            l.classList.remove('selected');
          }
        });
      });

      label.addEventListener('mouseenter', function() {
        starLabels.forEach((l, i) => {
          if (i <= index) {
            l.classList.add('hover');
          } else {
            l.classList.remove('hover');
          }
        });
      });
    });

    document.querySelector('.rating-selector').addEventListener('mouseleave', function() {
      starLabels.forEach(l => l.classList.remove('hover'));
    });

    // Form submission
    document.querySelector('.review-form').addEventListener('submit', function(e) {
      e.preventDefault();
      alert('Review submitted successfully!');
      this.reset();
      closeReviewModal();
    });
</script>


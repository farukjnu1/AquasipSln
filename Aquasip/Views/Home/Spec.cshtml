@model Aquasip.Models.ProductVM
@{
    ViewData["Title"] = "AquaSip | Spec";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["layout"];
    
    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() : viewModel.Where(x => x.Slug == "layout").First();
    
    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var oLogo = layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
     : layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").First();

    var oMedia0 = Model.ListProductMedia.Count > 0 ? Model.ListProductMedia[0] : new ProductMediumVM();
}
<style>
    /* styles.css */
    :root {
        font-family: "Segoe UI", Arial, sans-serif;
        color: #1d1d1d;
        background: #f6f7fb;
        line-height: 1.6;
    }

    body {
        margin: 0;
        padding: 20px;
    }

    .product-page {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 32px;
    }

    .product-gallery,
    .product-details {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .main-image {
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 16px;
    }

        .main-image img {
            width: 100%;
            display: block;
            object-fit: cover;
            min-height: 360px;
        }

    .thumbs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .thumb {
        cursor: pointer;
        border-radius: 12px;
        border: 2px solid transparent;
        object-fit: cover;
        height: 100px;
        width: 100%;
    }

        .thumb:hover,
        .thumb.active {
            border-color: #4f46e5;
        }

    .product-details h1 {
        margin-top: 0;
        font-size: 2rem;
    }

    .price {
        color: #4f46e5;
        font-size: 1.75rem;
        margin: 12px 0;
        font-weight: 700;
    }

    .description {
        margin-bottom: 24px;
        color: #555;
    }

    .specs h2,
    .additional-info h2 {
        margin-bottom: 12px;
    }

    .specs ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .specs li {
        padding: 10px 0;
        border-bottom: 1px solid #ececec;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin: 24px 0;
    }

    .buy-btn,
    .wishlist-btn {
        flex: 1;
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        cursor: pointer;
    }

    .buy-btn {
        background: #4f46e5;
        color: #fff;
    }

    .wishlist-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    @@media (max-width: 900px) {
        .product-page

    {
        grid-template-columns: 1fr;
    }

    .thumbs {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    }

    @@media (max-width: 640px) {
        body

    {
        padding: 12px;
    }

    .thumb {
        height: 80px;
    }

    }
</style>
<!-- Navbar & Hero Start -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="/" class="navbar-brand p-0">
            @if (oLogo.IsActive == true)
            {
                <h1 class="text-primary m-0"><img src="@oLogo.FilePath" /></h1>
            }
            else
            {
                <h1 class="text-primary m-0">YOUR-LOGO</h1>
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link">Home</a>
                <a href="/Home/Products" class="nav-item nav-link">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link active">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link">Gallery</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
                <a href="/Home/Review" class="nav-item nav-link">Review</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
            </div>
            <div class="d-none d-xl-flex me-3">
                <div class="d-flex flex-column pe-3 border-end border-primary">
                    <span class="text-body">Get Free Delivery</span>
                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header Start -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Specification</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active text-primary">Specification</li>
            </ol>
        </div>
    </div>
    <!-- Header End -->
</div>
<!-- Navbar & Hero End -->
<!-- Contact Start -->
<div class="container-fluid contact bg-light py-5">
    <div class="container py-5">
        <main class="product-page">
            <section class="product-gallery">
                <div class="main-image">
                    <img src="@oMedia0.FilePath" alt="Product image 1" id="currentImage" />
                </div>
                <div class="thumbs">
                    @for (var i = 0; i < Model.ListProductMedia.Count; i++)
                    {
                        var active = i == 0 ? "active" : "";
                        <img src="@Model.ListProductMedia[i].FilePath" alt="Product image 2" data-src="@Model.ListProductMedia[i].FilePath" class="thumb @active" />
                    }
                </div>
            </section>

            <section class="product-details">
                <h1>@Model.ProductName</h1>
                <p class="price">BDT @Model.Price</p>
                <p class="description">
                    @Model.ProductCode
                </p>

                <div class="specs">
                    <h2>Product Specifications</h2>
                    @Html.Raw(Model.Description)
                </div>

                <div class="actions">
                    <form asp-action="Cart" asp-controller="Home" method="post">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        Quantity: <input type="number" name="quantity" value="1" min="1" style="width:120px;height:48px" />
                        <button class="buy-btn">Add to Cart</button> 
                        @* <button class="wishlist-btn">Add to Wishlist</button> *@
                    </form>
                </div>

                @* <div class="additional-info">
                    <h2>More Details</h2>
                    <p>Lightweight design, premium memory foam ear cushions, and an included carry case make this the ideal travel companion.</p>
                </div> *@
            </section>
        </main>
    </div>
</div>
<!-- Contact End -->

<script>
    const thumbs = document.querySelectorAll('.thumb');
    const currentImage = document.getElementById('currentImage');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        document.querySelector('.thumb.active').classList.remove('active');
        thumb.classList.add('active');
        currentImage.src = thumb.dataset.src;
      });
    });
</script>

<!-- JavaScript Libraries -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Template Javascript -->
<script src="~/lib/wow/wow.min.js"></script>
<script src="~/lib/easing/easing.min.js"></script>
<script src="~/lib/waypoints/waypoints.min.js"></script>
<script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
<script src="~/js/main.js"></script>
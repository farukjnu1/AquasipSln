@model Aquasip.Models.ProductVM
@{
    ViewData["Title"] = "AquaSip | Spec";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["aquasip"];
    
    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() 
        : viewModel.Where(x => x.Slug == "layout").First();
    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var specPage = viewModel.Where(x => x.Slug == "spec").FirstOrDefault() == null ? new PageVM()
        : viewModel.Where(x => x.Slug == "spec").First();
    var oMedia0 = Model.ListProductMedia.Count > 0 ? Model.ListProductMedia[0] : new ProductMediumVM();

    var oNavbar = new Aquasip.Models.NavbarVM()
    {
        Name = specPage.Title,
        Slug = specPage.Slug,
        Pages = (List<PageVM>)viewModel
    };

}

<style>
    /* styles.css */
    :root {
        font-family: "Segoe UI", Arial, sans-serif;
        color: #1d1d1d;
        background: #f6f7fb;
        line-height: 1.6;
    }

    body {
        margin: 0;
        padding: 20px;
    }

    .product-page {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 32px;
    }

    .product-gallery,
    .product-details {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .main-image {
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 16px;
    }

        .main-image img {
            width: 100%;
            display: block;
            object-fit: cover;
            min-height: 360px;
        }

    .thumbs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .thumb {
        cursor: pointer;
        border-radius: 12px;
        border: 2px solid transparent;
        object-fit: cover;
        height: 100px;
        width: 100%;
    }

        .thumb:hover,
        .thumb.active {
            border-color: #4f46e5;
        }

    .product-details h1 {
        margin-top: 0;
        font-size: 2rem;
    }

    .price {
        color: #4f46e5;
        font-size: 1.75rem;
        margin: 12px 0;
        font-weight: 700;
    }

    .description {
        margin-bottom: 24px;
        color: #555;
    }

    .specs h2,
    .additional-info h2 {
        margin-bottom: 12px;
    }

    .specs ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .specs li {
        padding: 10px 0;
        border-bottom: 1px solid #ececec;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin: 24px 0;
    }

    .buy-btn,
    .wishlist-btn {
        flex: 1;
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        cursor: pointer;
    }

    .buy-btn {
        background: #4f46e5;
        color: #fff;
    }

    .wishlist-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    @@media (max-width: 900px) {
        .product-page

    {
        grid-template-columns: 1fr;
    }

    .thumbs {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    }

    @@media (max-width: 640px) {
        body

    {
        padding: 12px;
    }

    .thumb {
        height: 80px;
    }

    }
</style>

<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->

<!-- Spec Start -->
<div class="container-fluid contact bg-light py-5">
    <div class="container py-5">
        <main class="product-page">
            <section class="product-gallery">
                <div class="main-image">
                    <img src="@oMedia0.FilePath" alt="Product image 1" id="currentImage" />
                </div>
                <div class="thumbs">
                    @for (var i = 0; i < Model.ListProductMedia.Count; i++)
                    {
                        var active = i == 0 ? "active" : "";
                        <img src="@Model.ListProductMedia[i].FilePath" alt="Product image 2" data-src="@Model.ListProductMedia[i].FilePath" class="thumb @active" />
                    }
                </div>
            </section>

            <section class="product-details">
                <h1>@Model.ProductName</h1>
                <p class="price">BDT @Model.Price</p>
                <p class="description">
                    @Model.ProductCode
                </p>

                <div class="specs">
                    <h2>Product Specifications</h2>
                    @Html.Raw(Model.Description)
                </div>

                <div class="actions">
                    <form asp-action="Cart" asp-controller="Home" method="post">
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        Quantity: <input type="number" name="quantity" value="1" min="1" style="width:120px;height:48px" />
                        <button class="buy-btn">Add to Cart</button> 
                        @* <button class="wishlist-btn">Add to Wishlist</button> *@
                    </form>
                </div>

                @* <div class="additional-info">
                    <h2>More Details</h2>
                    <p>Lightweight design, premium memory foam ear cushions, and an included carry case make this the ideal travel companion.</p>
                </div> *@
            </section>
        </main>
    </div>
</div>
<!-- Spec End -->

<script>
    const thumbs = document.querySelectorAll('.thumb');
    const currentImage = document.getElementById('currentImage');

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        document.querySelector('.thumb.active').classList.remove('active');
        thumb.classList.add('active');
        currentImage.src = thumb.dataset.src;
      });
    });
</script>
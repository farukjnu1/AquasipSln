<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .policy-container {
        max-width: 900px;
        margin: 0 auto;
        background: white;
        border-radius: 28px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        overflow: hidden;
        padding: 2rem 1.8rem;
    }

    @@media (min-width: 640px) {
        .policy-container {
            padding: 2.5rem 2.8rem;
        }
    }

    .last-updated {
        color: #4a627a;
        font-size: 0.85rem;
        border-bottom: 1px solid #e2edf2;
        padding-bottom: 1rem;
        margin-bottom: 1.8rem;
    }


    .highlight-box {
        background: #eef4fa;
        border-left: 4px solid #2c7da0;
        padding: 1rem 1.2rem;
        border-radius: 16px;
        margin: 1.2rem 0;
        font-size: 0.95rem;
    }

    .contact-line {
        background: #fef7e0;
        padding: 1rem 1.2rem;
        border-radius: 20px;
        margin-top: 1.8rem;
        border: 1px solid #ffecb3;
    }


    .badge-note {
        background: #f9f2e6;
        color: #b45309;
        border-radius: 30px;
        padding: 0.2rem 0.8rem;
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 500;
        margin-left: 0.6rem;
        vertical-align: middle;
    }
</style>
<!-- Navbar & Hero Start -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="/" class="navbar-brand p-0">
            @if (oLogo.IsActive == true)
            {
                <h1 class="text-primary m-0"><img src="@oLogo.FilePath" /></h1>
            }
            else
            {
                <h1 class="text-primary m-0">YOUR-LOGO</h1>
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link active">Home</a>
                <a href="/Home/Products" class="nav-item nav-link">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link ">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link">Gallery</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
            </div>
            <div class="d-none d-xl-flex me-3">
                <div class="d-flex flex-column pe-3 border-end border-primary">
                    <span class="text-body">Get Free Delivery</span>
                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header Start -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Terms & Conditions</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active text-primary">Terms</li>
            </ol>
        </div>
    </div>
    <!-- Header End -->
</div>
<!-- Navbar & Hero End -->

<div class="policy-container pt-5 pb-5">

    <h1>Terms & Conditions · <span style="color:#1f6392;">@Html.Raw(term.Title)</span></h1>

    <p>@Html.Raw(term.Header)</p>

    <p>@Html.Raw(term.Body)</p>

    <div class="last-updated"><strong>Last updated:</strong> @Html.Raw(term.Footer)</div>
</div>

<!-- JavaScript Libraries -->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Template Javascript -->
<script src="~/lib/wow/wow.min.js"></script>
<script src="~/lib/easing/easing.min.js"></script>
<script src="~/lib/waypoints/waypoints.min.js"></script>
<script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
<script src="~/js/main.js"></script>



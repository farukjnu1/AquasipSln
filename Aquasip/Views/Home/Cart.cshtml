            @* <h1 class="text-primary"><i class="fas fa-hand-holding-water me-3"></i>@websiteName.SettingValue</h1> *@
            <img src="~/img/logo.png" alt="Logo">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link">Home</a>
                <a href="/Home/Products" class="nav-item nav-link">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link active">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link">Gallery</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
            </div>
            <div class="d-none d-xl-flex me-3">

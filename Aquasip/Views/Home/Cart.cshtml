@model IEnumerable<Aquasip.Models.ProductVM>
@{
    ViewData["Title"] = "AquaSip | Spec";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["layout"];

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() : viewModel.Where(x => x.Slug == "layout").First();

    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var oLogo = layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
     : layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").First();

    // var oMedia0 = Model.ListProductMedia.Count > 0 ? Model.ListProductMedia[0] : new ProductMediumVM();

    var cartPage = viewModel.Where(x => x.Slug == "cart").FirstOrDefault() == null ? new PageVM() : viewModel.Where(x => x.Slug == "cart").First();
    var delivery_charge = cartPage.PageContents.Where(x => x.SlugPageContent == "delivery_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.SlugPageContent == "delivery_charge").First();
    var gateway_charge = cartPage.PageContents.Where(x => x.SlugPageContent == "gateway_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.SlugPageContent == "gateway_charge").First();
    decimal? grandTotal = 0;
    decimal? subTotal = 0;
    foreach (var item in Model)
    {
        subTotal += item.Total == null ? 0 : item.Total;
    }
    grandTotal += subTotal;
    grandTotal += Convert.ToDecimal(delivery_charge.Header);
    grandTotal += Convert.ToDecimal(gateway_charge.Header);
}
<style>
    /* cart page additions */
    .cart-header {
        margin-bottom: 24px;
    }

        .cart-header h1 {
            margin: 0 0 8px;
            font-size: 2rem;
        }

        .cart-header p {
            margin: 0;
            color: #555;
        }

    .cart-content {
        display: grid;
        grid-template-columns: 1.5fr 0.6fr;
        gap: 24px;
    }

    .cart-items {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .cart-item {
        display: grid;
        grid-template-columns: 3fr 1fr 1fr 1fr;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid #ececec;
    }

        .cart-item:last-of-type {
            border-bottom: none;
        }

    .cart-item-header {
        font-weight: 700;
        color: #4f46e5;
        border-bottom: 2px solid #ececec;
        padding-bottom: 14px;
    }

    .item-product {
        display: flex;
        gap: 16px;
        align-items: center;
    }

        .item-product img {
            width: 90px;
            height: 90px;
            border-radius: 16px;
            object-fit: cover;
        }

        .item-product h2 {
            margin: 0 0 6px;
            font-size: 1rem;
        }

        .item-product p {
            margin: 0;
            color: #666;
            font-size: 0.95rem;
        }

    .item-price,
    .item-total {
        font-weight: 600;
        color: #1d1d1d;
    }

    .item-qty input {
        width: 72px;
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        text-align: center;
    }

    .cart-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 24px;
    }

    .order-summary {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

        .order-summary h2 {
            margin-top: 0;
        }

    .summary-row,
    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 1rem;
    }

    .summary-total {
        margin-top: 16px;
        font-weight: 700;
        font-size: 1.1rem;
        color: #1d1d1d;
    }

    .checkout-btn,
    .secondary-btn,
    .danger-btn {
        width: 100%;
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        cursor: pointer;
    }

    .checkout-btn {
        background: #4f46e5;
        color: #fff;
        margin-top: 18px;
    }

    .secondary-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .danger-btn {
        background: #fee2e2;
        color: #b91c1c;
    }

    @@media (max-width: 960px) {
        .cart-content

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 680px) {
        .cart-item

    {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .cart-item-header {
        grid-template-columns: 1fr;
    }

    .cart-actions {
        flex-direction: column;
    }

    }
</style>


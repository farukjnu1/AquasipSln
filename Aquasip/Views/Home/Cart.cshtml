                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header Start -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Shopping Cart</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active text-primary">Cart</li>
            </ol>
        </div>
    </div>
    <!-- Header End -->
</div>
<!-- Navbar & Hero End -->
<!-- Contact Start -->
<div class="container-fluid contact bg-light py-5">
    <div class="container py-5">
        @* <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Unit Price</th>
                    <th>Quantity</th>
                    <th style="text-align:right">Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price</td>
                        <td>@item.Quantity</td>
                        <td style="text-align:right">@item.Total</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (delivery_charge.IsActive==true)
                {
                    <tr>
                        <th></th>
                        <th></th>
                        <th style="text-align:right">@delivery_charge.Title:</th>
                        <th style="text-align:right">@delivery_charge.Header</th>
                    </tr>
                }
                @if (gateway_charge.IsActive == true)
                {
                    <tr>
                        <th></th>
                        <th></th>
                        <th style="text-align:right">@gateway_charge.Title:</th>
                        <th style="text-align:right">@gateway_charge.Header</th>
                    </tr>
                }
                <tr>
                    <th></th>
                    <th></th>
                    <th style="text-align:right">Total:</th>
                    <th style="text-align:right">@grandTotal</th>
                </tr>
            </tfoot>
        </table> *@

        <main class="cart-page">
            <header class="cart-header">
                <h1>Shopping Cart</h1>
                <p>Review your items, update quantities, or continue shopping.</p>
            </header>

            <section class="cart-content">
                <div class="cart-items">
                    <div class="cart-item cart-item-header">
                        <span>Product</span>
                        <span>Price</span>
                        <span>Qty</span>
                        <span>Total</span>
                    </div>

                    @foreach (var item in Model)
                    {
                        string FilePath = item.ListProductMedia.Count > 0 ? item.ListProductMedia[0].FilePath : "";

                        <div class="cart-item">
                            <div class="item-product">
                                <img src="@FilePath" alt="Product 1" />
                                <div>
                                    <h2>@item.ProductName</h2>
                                    <p>@item.ProductCode</p>
                                </div>
                            </div>
                            <div class="item-price">@item.Price</div>
                            <div class="item-qty">
                                <input type="number" min="1" value="@item.Quantity" readonly />
                            </div>
                            <div class="item-total">@item.Total</div>
                        </div>
                    }

                    <div class="cart-actions">
                        <button class="secondary-btn" onclick="goToProducts()">Continue Shopping</button>
                        <button class="danger-btn" onclick="clearCart()">Clear Cart</button>
                    </div>
                </div>

                <aside class="order-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>@subTotal</span>
                    </div>
                    <div class="summary-row">
                        <span>Tax</span>
                        <span>0</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping</span>
                        <span>@delivery_charge.Header</span>
                    </div>
                    <div class="summary-row">
                        <span>Gateway Fee</span>
                        <span>@gateway_charge.Header</span>
                    </div>
                    <div class="summary-total">
                        <span>Total</span>
                        <span>@grandTotal</span>
                    </div>
                    <button class="checkout-btn">Proceed to Checkout</button>
                </aside>
            </section>
        </main>
    </div>
</div>
<!-- Contact End -->

<script>
    function clearCart(){
        location.href='/Home/CartClear';
    }

    function goToProducts(){
        location.href='/Home/Products';
    }
</script>


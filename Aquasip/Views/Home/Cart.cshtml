@model IEnumerable<Aquasip.Models.ProductVM>
@{
    ViewData["Title"] = "AquaSip | Cart";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["aquasip"];

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() 
    : viewModel.Where(x => x.Slug == "layout").First();

    var cartPage = viewModel.Where(x => x.Slug == "cart").FirstOrDefault();
    if (cartPage == null)
    {
        cartPage = new PageVM()
        {
            Title = "Cart",
            Slug = "cart"
        };
    }
    var oNavbar = new Aquasip.Models.NavbarVM()
    {
        Name = cartPage.Title,
        Slug = cartPage.Slug,
        Pages = (List<PageVM>)viewModel
    };

    var delivery_charge = cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "delivery_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "delivery_charge").First();
    var gateway_charge = cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "gateway_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "gateway_charge").First();
    var vat = cartPage.PageContents.Where(x => x.IsActive==true && x.SlugPageContent == "vat").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "vat").First();
    decimal? grandTotal = 0;
    decimal? subTotal = 0;
    decimal? vatedValue = 0;
    foreach (var item in Model)
    {
        subTotal += item.Total == null ? 0 : item.Total;
    }
    grandTotal += subTotal;
    if (grandTotal > 0)
    {
        if (vat.IsActive == true)
        {
            grandTotal += subTotal * (Convert.ToDecimal(vat.Header) / 100);
            vatedValue = subTotal * (Convert.ToDecimal(vat.Header) / 100);
            vatedValue = Math.Round(Convert.ToDecimal(vatedValue), 2);
        }
        if (delivery_charge.IsActive == true)
        {
            grandTotal += Convert.ToDecimal(delivery_charge.Header);

        }
        if (gateway_charge.IsActive == true)
        {
            grandTotal += Convert.ToDecimal(gateway_charge.Header);
        }
        grandTotal = Math.Round(Convert.ToDecimal(grandTotal), 2);
    }

    
}

<style>
    /* cart page additions */
    .cart-header {
        margin-bottom: 24px;
    }

        .cart-header h1 {
            margin: 0 0 8px;
            font-size: 2rem;
        }

        .cart-header p {
            margin: 0;
            color: #555;
        }

    .cart-content {
        display: grid;
        grid-template-columns: 1.5fr 0.6fr;
        gap: 24px;
    }

    .cart-items {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .cart-item {
        display: grid;
        grid-template-columns: 3fr 1fr 1fr 1fr;
        align-items: center;
        gap: 16px;
        padding: 18px 0;
        border-bottom: 1px solid #ececec;
    }

        .cart-item:last-of-type {
            border-bottom: none;
        }

    .cart-item-header {
        font-weight: 700;
        color: #4f46e5;
        border-bottom: 2px solid #ececec;
        padding-bottom: 14px;
    }

    .item-product {
        display: flex;
        gap: 16px;
        align-items: center;
    }

        .item-product img {
            width: 90px;
            height: 90px;
            border-radius: 16px;
            object-fit: cover;
        }

        .item-product h2 {
            margin: 0 0 6px;
            font-size: 1rem;
        }

        .item-product p {
            margin: 0;
            color: #666;
            font-size: 0.95rem;
        }

    .item-price,
    .item-total {
        font-weight: 600;
        color: #1d1d1d;
    }

    .item-qty input {
        width: 72px;
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        text-align: center;
    }

    .cart-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 24px;
    }

    .order-summary {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

        .order-summary h2 {
            margin-top: 0;
        }

    .summary-row,
    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        font-size: 1rem;
    }

    .summary-total {
        margin-top: 16px;
        font-weight: 700;
        font-size: 1.1rem;
        color: #1d1d1d;
    }

    .checkout-btn,
    .secondary-btn,
    .danger-btn {
        width: 100%;
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        cursor: pointer;
    }

    .checkout-btn {
        background: #4f46e5;
        color: #fff;
        margin-top: 18px;
    }

    .secondary-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .danger-btn {
        background: #fee2e2;
        color: #b91c1c;
    }

    @@media (max-width: 960px) {
        .cart-content

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 680px) {
        .cart-item

    {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .cart-item-header {
        grid-template-columns: 1fr;
    }

    .cart-actions {
        flex-direction: column;
    }

    }
</style>

<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->

<!-- cart Start -->
<div class="container-fluid contact bg-light py-1">
    <div class="container py-1">

        <main class="cart-page">
            <header class="cart-header">
                <h1>Shopping Cart</h1>
                <p>Review your items, update quantities, or continue shopping.</p>
            </header>

            <section class="cart-content">
                <div class="cart-items">
                    <div class="cart-item cart-item-header">
                        <span>Product</span>
                        <span>Price</span>
                        <span>Qty</span>
                        <span>Total</span>
                        <span>#</span>
                    </div>

                    @foreach (var item in Model)
                    {
                        string FilePath = item.ListProductMedia.Count > 0 ? item.ListProductMedia[0].FilePath : "";

                        <div class="cart-item">
                            <div class="item-product">
                                <a href="javascript:void(0)" class="text-danger" onclick="clearCart(@item.ProductId)" title="Remove from cart">
                                    <i class="fas fa-times"></i>
                                </a>
                                <img src="@FilePath" alt="Product 1" />
                                <div>
                                    <h2>@item.ProductName</h2>
                                    <p>@item.ProductCode</p>
                                </div>
                            </div>
                            <div class="item-price">@item.Price</div>
                            <div class="item-qty">
                                <a href="javascript:void(0)" class="text-danger" onclick="updateCart(@item.ProductId, @item.Quantity, '-')">
                                    <i class="fas fa-minus"></i>
                                </a>
                                <input type="number" name="Quantity" id="Quantity_@item.ProductId" min="1" value="@item.Quantity" readonly />
                                <a href="javascript:void(0)" class="text-success" onclick="updateCart(@item.ProductId, @item.Quantity, '+')">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                            <div class="item-total">@item.Total</div>
                        </div>
                    }

                    @if (Model.Count() == 0)
                    {
                        <h5 style="text-align:center">Cart is empty!</h5>
                    }

                    <div class="cart-actions">
                        <button class="secondary-btn" onclick="goToProducts()">Continue Shopping</button>
                        <button class="danger-btn" onclick="clearAllCart()">Clear Cart</button>
                    </div>
                </div>

                <input type="hidden" id="subTotal" value="@subTotal" />
                <aside class="order-summary">
                    <h2>Order Summary</h2>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>@subTotal</span>
                    </div>
                    @if (vat.IsActive == true)
                    {
                        <div class="summary-row">
                            <span>@vat.Title @vat.Header</span>
                            <span>@vatedValue</span>
                        </div>
                    }
                    @if (delivery_charge.IsActive == true)
                    {
                        <div class="summary-row">
                            <span>@delivery_charge.Title</span>
                            <span>@delivery_charge.Header</span>
                        </div>
                    }
                    @if (gateway_charge.IsActive == true)
                    {
                        <div class="summary-row">
                            <span>@gateway_charge.Title</span>
                            <span>@gateway_charge.Header</span>
                        </div>
                    }
                    
                    <div class="summary-total">
                        <span>Total</span>
                        <span>@grandTotal</span>
                    </div>
                    <button class="checkout-btn" onclick="gotToCheckout()">Proceed to Checkout</button>
                </aside>
            </section>
        </main>
    </div>
</div>
<!-- cart End -->

<script>
    function clearAllCart(){
        location.href='/Home/CartClearAll';
    }

    function clearCart(id){
        location.href='/Home/CartClear?id='+id;
    }

    function goToProducts(){
        location.href='/Home/Products';
    }

    function gotToCheckout(){
        var subTotal = parseFloat(document.getElementById('subTotal').value);
        if(subTotal>0){
            location.href='/Home/Checkout';
        }
    }

    function updateCart(id, qty, operator){
        if(operator == '+') {
            qty += 1;
            location.href='/Home/CartUpdate?productId='+id+'&quantity='+qty;
        } else if(operator == '-' && qty > 1){
            qty -= 1;
            location.href='/Home/CartUpdate?productId='+id+'&quantity='+qty;
        }
        
    }
</script>

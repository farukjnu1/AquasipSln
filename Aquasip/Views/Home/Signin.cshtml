@model Aquasip.EF.Customer

@{
    ViewData["Title"] = "Sign-in";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["aquasip"];

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM()
        : viewModel.Where(x => x.Slug == "layout").First();

    // var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    //     : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var homePage = viewModel.Where(x => x.Slug == "home").FirstOrDefault() == null ? new PageVM()
        : viewModel.Where(x => x.Slug == "home").First();
    //var oMedia0 = Model.ListProductMedia.Count > 0 ? Model.ListProductMedia[0] : new ProductMediumVM();

    var oNavbar = new Aquasip.Models.NavbarVM()
    {
        Name = homePage.Title,
        Slug = homePage.Slug,
        Pages = (List<PageVM>)viewModel
    };
}
<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->
<div class="container">
    <h1>Sign-in</h1>

    <h4>Customer</h4>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Signin">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input type="email" asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PasswordHash" class="control-label"></label>
                    <input type="password" asp-for="PasswordHash" class="form-control" />
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>
                <div class="form-group pt-2">
                    <input type="submit" value="Ok" class="btn btn-primary" />
                </div>
            </form>
            <div id="Verification">
                <form asp-action="SendVerification">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input type="email" asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group pt-2">
                        <input type="submit" value="Send Verification" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        Don't have an account? <a asp-action="Signup">Sign-up</a>
        <br />
        Verified? <a href="javascript:void(0)" onclick="showVerification()">Verification</a>
    </div>

</div>

@* @section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} *@

<script>
    
    function documentReady(){
        $(document).ready(function () {
            hideVerification();
        });
    }

    function hideVerification(){
        $('#Verification').hide();
    }

    function showVerification(){
        $('#Verification').show();
    }

    setTimeout(() => {
        console.log("This runs after 1 seconds");
        documentReady();
    }, 1000); // 10000 ms = 10 seconds
</script>

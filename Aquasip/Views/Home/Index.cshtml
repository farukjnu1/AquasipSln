@model IEnumerable<Aquasip.Models.PageVM>
@using Aquasip.Utilities
@{
    var pRepo = new Aquasip.Repositories.PageRepository(WebsiteConfig.ConnectionString);
    var pcRepo = new Aquasip.Repositories.PageContentRepository(WebsiteConfig.ConnectionString);

    var layoutPage = pRepo.GetBySlug("layout");
    layoutPage.PageContents = pcRepo.GetBySlugPage("layout");

    var oLogo = layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").First();


    var oHome = Model.Where(x => x.Slug == "home").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "home").First();

    var listSlide = oHome.PageContents.Where(x => x.SlugPageContent == "slides" && x.IsActive == true).ToList();
    var oSlide0 = listSlide.Count() > 0 ? listSlide[0] : new PageContentVM();
    var oSlide1 = listSlide.Count() > 1 ? listSlide[1] : new PageContentVM();

    var oService = Model.Where(x => x.Slug == "services").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "services").First();
    var ourService = oService.PageContents.Where(x => x.SlugPageContent == "our_services").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oService.PageContents.Where(x => x.SlugPageContent == "our_services").First();
    var listService = oService.PageContents.Where(x => x.SlugPageContent == "services" && Convert.ToString(x.Description).ToLower() == "home").Take(8).ToList();

    var oAbout = Model.Where(x => x.Slug == "about").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "about").First();
    var aboutUs = oAbout.PageContents.Where(x => x.SlugPageContent == "about").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oAbout.PageContents.Where(x => x.SlugPageContent == "about").First();
    var aboutImg = oAbout.PageContents.Where(x => x.SlugPageContent == "about_img").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oAbout.PageContents.Where(x => x.SlugPageContent == "about_img").First();
    var listAbout = oAbout.PageContents.Where(x => x.SlugPageContent == "abouts").ToList();

    var oOurTeam = Model.Where(x => x.Slug == "our_team").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "our_team").First();
    var ourTeam = oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_team").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_team").First();
    var listOurTeam = oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_teams" && Convert.ToString(x.Description).ToLower() == "home").Take(4).ToList();

    var oTestimonial = Model.Where(x => x.Slug == "testimonial").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "testimonial").First();
    var testimonial = oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonial").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonial").First();
    var listTestimonial = oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonials" && Convert.ToString(x.Description).ToLower() == "home").ToList();

    var oOurBlog = Model.Where(x => x.Slug == "our_blog").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "our_blog").First();
    var ourBlog = oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blog").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blog").First();
    var listOurBlog = oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blogs").OrderByDescending(y => y.UploadedAt).Take(3).ToList();

    //var layoutPage = Model.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "layout").First();

    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    //var websiteName = layoutPage.SiteSettings.Where(x => x.SettingKey == "website-name").FirstOrDefault() == null ? new SiteSettingVM() : layoutPage.SiteSettings.Where(x => x.SettingKey == "website-name").First();

    //var oHome = Model.Where(x => x.Slug == "home").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "home").First();
    var listProduct = oHome.Products;
    var section1 = oHome.PageContents.Where(x => x.SlugPageContent == "section1" && x.IsActive == true).FirstOrDefault();
    var section1_img1 = oHome.PageContents.Where(x => x.SlugPageContent == "section1-img1" && x.IsActive == true).FirstOrDefault();
    var section1_img2 = oHome.PageContents.Where(x => x.SlugPageContent == "section1-img2" && x.IsActive == true).FirstOrDefault();
    var section1_img1_Src = section1_img1 == null ? "/img/No_Image_Available.jpg" : section1_img1.FilePath;
    var section1_img2_Src = section1_img2 == null ? "/img/No_Image_Available.jpg" : section1_img2.FilePath;

    var section2 = oHome.PageContents.Where(x => x.SlugPageContent == "section2" && x.IsActive == true).FirstOrDefault();
    var section2_img1 = oHome.PageContents.Where(x => x.SlugPageContent == "section2-img1" && x.IsActive == true).FirstOrDefault();
    var section2_img2 = oHome.PageContents.Where(x => x.SlugPageContent == "section2-img2" && x.IsActive == true).FirstOrDefault();
    var section2_img3 = oHome.PageContents.Where(x => x.SlugPageContent == "section2-img3" && x.IsActive == true).FirstOrDefault();
    var section2_img1_Src = section2_img1 == null ? "/img/No_Image_Available.jpg" : section2_img1.FilePath;
    var section2_img2_Src = section2_img2 == null ? "/img/No_Image_Available.jpg" : section2_img2.FilePath;
    var section2_img3_Src = section2_img3 == null ? "/img/No_Image_Available.jpg" : section2_img3.FilePath;
    
    var section3 = oHome.PageContents.Where(x => x.SlugPageContent == "section3" && x.IsActive == true).FirstOrDefault();
    var section3_img1 = oHome.PageContents.Where(x => x.SlugPageContent == "section3-img1" && x.IsActive == true).FirstOrDefault();
    var section3_img2 = oHome.PageContents.Where(x => x.SlugPageContent == "section3-img2" && x.IsActive == true).FirstOrDefault();
    var section3_img3 = oHome.PageContents.Where(x => x.SlugPageContent == "section3-img3" && x.IsActive == true).FirstOrDefault();
    var section3_img1_Src = section3_img1 == null ? "/img/No_Image_Available.jpg" : section3_img1.FilePath;
    var section3_img2_Src = section3_img2 == null ? "/img/No_Image_Available.jpg" : section3_img2.FilePath;
    var section3_img3_Src = section3_img3 == null ? "/img/No_Image_Available.jpg" : section3_img3.FilePath;

    var productsSection = oHome.PageContents.Where(x => x.SlugPageContent == "products" && x.IsActive == true).FirstOrDefault();

    ViewData["Title"] = "Home";
}

<!-- Navbar & Hero Start -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="/" class="navbar-brand p-0">
            @if (oLogo.IsActive == true)
            {
                <h1 class="text-primary m-0"><img src="@oLogo.FilePath" /></h1>
            }
            else
            {
                <h1 class="text-primary m-0"><img src="/img/No_Image_Available.jpg" /></h1>
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link active">Home</a>
                <a href="/Home/Products" class="nav-item nav-link">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link">Gallery</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
                <a href="/Home/Review" class="nav-item nav-link">Review</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
            </div>
            <div class="d-none d-xl-flex me-3">
                <div class="d-flex flex-column pe-3 border-end border-primary">
                    <span class="text-body">Get Free Delivery</span>
                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
            @* <a href="https://htmlcodex.com/downloading/?item=3402" class="btn btn-primary rounded-pill d-inline-flex flex-shrink-0 py-2 px-4">Buy Pro Version</a> *@
        </div>
    </nav>

    <!-- Carousel Start -->
    <div class="carousel-header">
        <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
            <ol class="carousel-indicators">
                <li data-bs-target="#carouselId" data-bs-slide-to="0" class="active"></li>
                <li data-bs-target="#carouselId" data-bs-slide-to="1"></li>
                <li data-bs-target="#carouselId" data-bs-slide-to="2"></li>
            </ol>
            <div class="carousel-inner" role="listbox">
                <div class="carousel-item active">
                    <img src="@oSlide0.FilePath" class="img-fluid w-100" alt="Image">
                    <div class="carousel-caption-1">
                        <div class="carousel-caption-1-content" style="max-width: 900px;">
                            <h4 class="text-white text-uppercase fw-bold mb-4 fadeInLeft animated" data-animation="fadeInLeft" data-delay="1s" style="animation-delay: 1s;" style="letter-spacing: 3px;">@oSlide0.Title</h4>
                            <h1 class="display-2 text-capitalize text-white mb-4 fadeInLeft animated" data-animation="fadeInLeft" data-delay="1.3s" style="animation-delay: 1.3s;">@oSlide0.Header</h1>
                            <p class="mb-5 fs-5 text-white fadeInLeft animated" data-animation="fadeInLeft" data-delay="1.5s" style="animation-delay: 1.5s;">
                                @oSlide0.Body
                            </p>
                            <div class="carousel-caption-1-content-btn fadeInLeft animated" data-animation="fadeInLeft" data-delay="1.7s" style="animation-delay: 1.7s;">
                                @* <a class="btn btn-primary rounded-pill flex-shrink-0 py-3 px-5 me-2" href="javascript:void(0)">Order Now</a> *@
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="@oSlide1.FilePath" class="img-fluid w-100" alt="Image">
                    <div class="carousel-caption-2">
                        <div class="carousel-caption-2-content" style="max-width: 900px;">
                            <h4 class="text-white text-uppercase fw-bold mb-4 fadeInRight animated" data-animation="fadeInRight" data-delay="1s" style="animation-delay: 1s;" style="letter-spacing: 3px;">@oSlide1.Title</h4>
                            <h1 class="display-2 text-capitalize text-white mb-4 fadeInRight animated" data-animation="fadeInRight" data-delay="1.3s" style="animation-delay: 1.3s;">@oSlide1.Header</h1>
                            <p class="mb-5 fs-5 text-white fadeInRight animated" data-animation="fadeInRight" data-delay="1.5s" style="animation-delay: 1.5s;">
                                @oSlide1.Body
                            <div class="carousel-caption-2-content-btn fadeInRight animated" data-animation="fadeInRight" data-delay="1.7s" style="animation-delay: 1.7s;">
                                @* <a class="btn btn-primary rounded-pill flex-shrink-0 py-3 px-5 me-2" href="javascript:void(0)">Order Now</a> *@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                <span class="carousel-control-prev-icon btn btn-primary fadeInLeft animated" aria-hidden="true" data-animation="fadeInLeft" data-delay="1.1s" style="animation-delay: 1.3s;"> <i class="fa fa-angle-left fa-3x"></i></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                <span class="carousel-control-next-icon btn btn-primary fadeInRight animated" aria-hidden="true" data-animation="fadeInLeft" data-delay="1.1s" style="animation-delay: 1.3s;"><i class="fa fa-angle-right fa-3x"></i></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
    <!-- Carousel End -->
</div>
<!-- Navbar & Hero End -->

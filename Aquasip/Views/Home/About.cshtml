
@{
    ViewData["Title"] = "About | AquaSip";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["aquasip"];

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM()
    : viewModel.Where(x => x.Slug == "layout").First();

    var oAbout = viewModel.Where(x => x.Slug == "about").FirstOrDefault() == null ? new PageVM() 
        : viewModel.Where(x => x.Slug == "about").First();
    var about = oAbout.PageContents.Where(x => x.SlugPageContent == "about").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() 
        :oAbout.PageContents.Where(x => x.SlugPageContent == "about").First();

    var oNavbar = new Aquasip.Models.NavbarVM()
    {
        Name = oAbout.Title,
        Slug = oAbout.Slug,
        Pages = (List<PageVM>)viewModel
    };

}

<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->

<!-- About Start -->
<div class="container-fluid about py-5">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-xl-6 wow fadeInLeft" data-wow-delay="0.2s">
                <div class="about-img rounded h-100">
                    <img src="@about.FilePath" class="img-fluid rounded h-100 w-100" style="object-fit: cover;" alt="">
                    <div class="about-exp"><span>@about.Title</span></div>
                </div>
            </div>
            <div class="col-xl-6 wow fadeInRight" data-wow-delay="0.2s">
                <div class="about-item">
                    <h4 class="text-primary text-uppercase">@about.Title</h4>
                    <h1 class="display-3 mb-3">@about.Header</h1>
                    <p class="mb-4">
                        @Html.Raw(@about.Body)
                    </p>
                    @Html.Raw(about.Footer)
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->


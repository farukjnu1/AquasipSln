@model IEnumerable<Aquasip.Models.ProductVM>
@{
    ViewData["Title"] = "Checkout | AquaSip";
    // Layout = "~/Views/Shared/_Layout.cshtml";

    var viewModel = (IEnumerable<Aquasip.Models.PageVM>)ViewData["aquasip"];

    var layoutPage = viewModel.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() 
    : viewModel.Where(x => x.Slug == "layout").First();

    var cartPage = viewModel.Where(x => x.Slug == "cart").FirstOrDefault() == null ? new PageVM() 
        : viewModel.Where(x => x.Slug == "cart").First();

    var delivery_charge = cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "delivery_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "delivery_charge").First();
    var gateway_charge = cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "gateway_charge").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
        : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "gateway_charge").First();
    var vat = cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "vat").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : cartPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "vat").First();
    decimal? grandTotal = 0;
    decimal? subTotal = 0;
    decimal? vatedValue = 0;
    foreach (var item in Model)
    {
        subTotal += item.Total == null ? 0 : item.Total;
    }
    grandTotal += subTotal;
    if (grandTotal > 0)
    {
        if (vat.IsActive == true)
        {
            grandTotal += subTotal * (Convert.ToDecimal(vat.Header) / 100);
            vatedValue = subTotal * (Convert.ToDecimal(vat.Header) / 100);
            vatedValue = Math.Round(Convert.ToDecimal(vatedValue), 2);
        }
        if (delivery_charge.IsActive == true)
        {
            grandTotal += Convert.ToDecimal(delivery_charge.Header);

        }
        if (gateway_charge.IsActive == true)
        {
            grandTotal += Convert.ToDecimal(gateway_charge.Header);
        }
        grandTotal = Math.Round(Convert.ToDecimal(grandTotal), 2);
    }

    var oNavbar = new Aquasip.Models.NavbarVM()
    {
        Name = cartPage.Title,
        Slug = cartPage.Slug,
        Pages = (List<PageVM>)viewModel
    };
}

<style>
    /* ========== CHECKOUT PAGE STYLES ========== */

    .checkout-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .checkout-header {
        background: linear-gradient(135deg, #4f46e5 0%, #667eea 100%);
        color: #fff;
        padding: 40px 24px;
        border-radius: 16px;
        margin-bottom: 40px;
        text-align: center;
    }

        .checkout-header h1 {
            margin: 0 0 12px 0;
            font-size: 2.5rem;
        }

    .breadcrumb {
        margin: 0;
        opacity: 0.9;
        font-size: 0.95rem;
    }

        .breadcrumb a {
            color: #fff;
            text-decoration: none;
            opacity: 0.8;
        }

            .breadcrumb a:hover {
                opacity: 1;
                text-decoration: underline;
            }

    .checkout-main {
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        gap: 32px;
        margin: 20px;
    }

    /* ===== CHECKOUT FORM SECTION ===== */

    .checkout-form-section {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .checkout-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    }

    .section-title {
        margin: 0 0 20px 0;
        font-size: 1.3rem;
        color: #1d1d1d;
        font-weight: 600;
    }

    /* ===== FORM STYLES ===== */

    .checkout-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group label {
        font-weight: 500;
        margin-bottom: 8px;
        color: #333;
        font-size: 0.95rem;
    }

    .form-group input,
    .form-group select {
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.3s ease;
    }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-group input::placeholder {
            color: #999;
        }

    /* ===== SHIPPING OPTIONS ===== */

    .shipping-options {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .shipping-option {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 16px;
        padding: 16px;
        border: 2px solid #ececec;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .shipping-option:hover {
            border-color: #4f46e5;
            background: #f9f8ff;
        }

        .shipping-option input[type="radio"] {
            cursor: pointer;
            width: 20px;
            height: 20px;
        }

    .option-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .option-name {
        font-weight: 500;
        color: #1d1d1d;
    }

    .option-time {
        font-size: 0.85rem;
        color: #666;
    }

    .option-price {
        font-weight: 600;
        color: #4f46e5;
    }

    /* ===== CHECKBOX & LABELS ===== */

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-weight: 500;
        margin-top: 16px;
    }

        .checkbox-label input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

    /* ===== PROMO CODE SECTION ===== */

    .promo-section {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
    }

    .promo-input {
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;
        font-family: inherit;
    }

        .promo-input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

    .promo-btn {
        padding: 12px 24px;
        background: #4f46e5;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .promo-btn:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(79, 70, 229, 0.3);
        }

    /* ===== ORDER SUMMARY SECTION ===== */

    .order-summary-section {
        display: flex;
        flex-direction: column;
    }

    .order-summary-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        height: fit-content;
        position: sticky;
        top: 20px;
    }

        .order-summary-card h2 {
            margin: 0 0 24px 0;
            font-size: 1.3rem;
            color: #1d1d1d;
        }

    /* ===== CART ITEMS ===== */

    .cart-items {
        margin-bottom: 20px;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: 16px;
        align-items: flex-start;
        padding-bottom: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid #ececec;
    }

        .cart-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .item-image {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        overflow: hidden;
        background: #f0f0f0;
    }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .item-details h4 {
        margin: 0 0 4px 0;
        font-size: 0.95rem;
        color: #1d1d1d;
    }

    .item-sku,
    .item-qty {
        margin: 0;
        font-size: 0.85rem;
        color: #666;
    }

    .item-qty {
        margin-top: 6px;
    }

    .item-price {
        font-weight: 700;
        color: #4f46e5;
        font-size: 1.1rem;
    }

    /* ===== SUMMARY DIVIDER ===== */

    .summary-divider {
        height: 1px;
        background: #ececec;
        margin: 16px 0;
    }

    /* ===== PRICE BREAKDOWN ===== */

    .price-breakdown {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .breakdown-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
        color: #555;
    }

        .breakdown-row.discount {
            color: #10b981;
            font-weight: 500;
        }

            .breakdown-row.discount span:last-child {
                color: #10b981;
                font-weight: 600;
            }

    /* ===== ORDER TOTAL ===== */

    .order-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1.2rem;
        font-weight: 700;
        color: #1d1d1d;
        margin: 16px 0;
    }

    .total-amount {
        color: #4f46e5;
        font-size: 1.5rem;
    }

    /* ===== CHECKOUT BUTTONS ===== */

    .checkout-btn,
    .continue-shopping-btn {
        width: 100%;
        padding: 14px 20px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-bottom: 12px;
    }

    .checkout-btn {
        background: #4f46e5;
        color: #fff;
    }

        .checkout-btn:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
        }

        .checkout-btn:active {
            transform: translateY(0);
        }

    .continue-shopping-btn {
        background: transparent;
        color: #4f46e5;
        border: 2px solid #4f46e5;
    }

        .continue-shopping-btn:hover {
            background: #f9f8ff;
            border-color: #4338ca;
            color: #4338ca;
        }

    /* ===== SECURITY INFO ===== */

    .security-info {
        text-align: center;
        padding-top: 12px;
        margin-top: 12px;
        border-top: 1px solid #ececec;
    }

        .security-info p {
            margin: 0;
            font-size: 0.85rem;
            color: #666;
        }

    /* ===== CHECKOUT FOOTER ===== */

    .checkout-footer {
        background: #f6f7fb;
        padding: 32px 24px;
        border-radius: 16px;
        text-align: center;
    }

    .footer-content p {
        margin: 0 0 12px 0;
        color: #666;
        font-size: 0.9rem;
    }

    .footer-links {
        margin: 0;
    }

        .footer-links a {
            color: #4f46e5;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .footer-links a:hover {
                text-decoration: underline;
            }

    /* ===== RESPONSIVE DESIGN ===== */

    @@media (max-width: 1024px) {
        .checkout-main

    {
        grid-template-columns: 1fr;
    }

    .order-summary-card {
        position: static;
        top: auto;
    }

    .form-row {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .checkout-header

    {
        padding: 30px 20px;
        margin-bottom: 24px;
    }

    .checkout-header h1 {
        font-size: 1.8rem;
    }

    .checkout-main {
        gap: 24px;
    }

    .checkout-card {
        padding: 20px;
    }

    .cart-item {
        grid-template-columns: 70px 1fr auto;
        gap: 12px;
    }

    .item-image {
        width: 70px;
        height: 70px;
    }

    }

    @@media (max-width: 640px) {
        .checkout-header h1

    {
        font-size: 1.4rem;
    }

    .breadcrumb {
        font-size: 0.85rem;
    }

    .checkout-card {
        padding: 16px;
    }

    .section-title {
        font-size: 1.1rem;
        margin-bottom: 16px;
    }

    .promo-section {
        grid-template-columns: 1fr;
    }

    .promo-btn {
        width: 100%;
    }

    .cart-item {
        grid-template-columns: 60px 1fr auto;
    }

    .item-image {
        width: 60px;
        height: 60px;
    }

    .checkout-btn,
    .continue-shopping-btn {
        padding: 12px 16px;
        font-size: 0.95rem;
    }

    .shipping-option {
        grid-template-columns: auto 1fr;
    }

    .option-price {
        grid-column: 2;
        justify-self: flex-start;
        margin-top: 8px;
    }

</style>

<!-- Navbar & Hero Start -->
<partial name="_NavbarTop" model="oNavbar" />
<!-- Navbar & Hero End -->

<div style="padding-left:30px;padding-bottom:10px;padding-right:30px;padding-top:10px">
    <h1>Checkout</h1>
    <p>Review your items, input address, or place a order</p>
</div>

<!-- Checkout Form -->
<form asp-controller="Home" asp-action="Checkout" method="post">
    <input type="hidden" name="OrderStateId" value="1" />
    <!-- Main Checkout Content -->
    <main class="checkout-main">

        <!-- Left Column: order-details -->
        <section class="checkout-form-section">
            <!-- products -->
            <div class="checkout-card">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string FilePath = item.ListProductMedia.Count > 0 ? item.ListProductMedia[0].FilePath : "";

                            <tr>
                                <td><img src="@FilePath" width="90px" /></td>
                                <td>
                                    @item.ProductName
                                    @item.ProductCode
                                </td>
                                <td>@item.Price</td>
                                <td>@item.Quantity</td>
                                <td>@item.Total</td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
            <!-- products -->
            <!-- Shipping Information -->
            <div class="checkout-card">
                <h2 class="section-title">1. Shipping Address</h2>
                <form class="checkout-form">
                    
                    <div class="form-group">
                        <label for="FullName">Name</label>
                        <input type="text" id="FullName" name="Customer.FullName" required>
                    </div>

                    <div class="form-group">
                        <label for="Email">Email Address</label>
                        <input type="Email" id="Email" name="Customer.Email" required>
                    </div>

                    <div class="form-group">
                        <label for="PhoneNumber">Phone Number</label>
                        <input type="tel" id="PhoneNumber" name="Customer.PhoneNumber" required>
                    </div>

                    <div class="form-group">
                        <label for="StreetAddress">Street Address</label>
                        <input type="text" id="StreetAddress" name="ShippingAddress.StreetAddress" placeholder="House number and street name" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="City">City</label>
                            <input type="text" id="City" name="ShippingAddress.City" required>
                        </div>
                        <div class="form-group">
                            <label for="StateProvince">State/Province</label>
                            <input type="text" id="StateProvince" name="ShippingAddress.StateProvince" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="PostalCode">Postal Code</label>
                            <input type="text" id="PostalCode" name="ShippingAddress.PostalCode" required>
                        </div>
                        <div class="form-group">
                            <label for="CountryCode">Country</label>
                            <select id="CountryCode" name="ShippingAddress.CountryCode" required>
                                <option value="">Select Country</option>
                                <option value="bd">Bangladesh</option>
                                <option value="us">United States</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Shipping Information -->
            <!-- Shipping Method -->
            <div class="checkout-card">
                <h2 class="section-title">2. Payment Method</h2>
                <div class="shipping-options">
                    <label class="shipping-option">
                        <input type="radio" name="PaymentMethodId" value="1" checked>
                        <div class="option-content">
                            <span class="option-name">Cash On Delivery</span>
                            <span class="option-time"></span>
                        </div>
                        <span class="option-price">0</span>
                    </label>
                    <label class="shipping-option">
                        <input type="radio" name="PaymentMethodId" value="2">
                        <div class="option-content">
                            <span class="option-name">bKash</span>
                            <span class="option-time">bKash-Number(merchant/personal)</span>
                        </div>
                        <span class="option-price">0</span>
                    </label>
                    <!--
                    <label class="shipping-option">
                        <input type="radio" name="shipping" value="overnight">
                        <div class="option-content">
                            <span class="option-name">Overnight Shipping</span>
                            <span class="option-time">Next business day</span>
                        </div>
                        <span class="option-price">$35.00</span>
                    </label>
                    -->

                </div>
            </div>
            <!-- Shipping Method -->

            <!-- Payment Information -->
            <!-- <div class="checkout-card">
                <h2 class="section-title">3. Payment Information</h2>
                <form class="checkout-form">
                    <div class="form-group">
                        <label for="cardname">Cardholder Name</label>
                        <input type="text" id="cardname" name="cardname" required>
                    </div>

                    <div class="form-group">
                        <label for="cardnumber">Card Number</label>
                        <input type="text" id="cardnumber" name="cardnumber" placeholder="1234 5678 9012 3456" maxlength="19" required>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiry">Expiry Date</label>
                            <input type="text" id="expiry" name="expiry" placeholder="MM/YY" maxlength="5" required>
                        </div>
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" name="cvv" placeholder="123" maxlength="4" required>
                        </div>
                    </div>
                </form>

                <label class="checkbox-label">
                    <input type="checkbox" name="billing-same" checked>
                    <span>Billing address same as shipping</span>
                </label>
            </div> -->
            <!-- Promo Code -->
            <!--<div class="checkout-card">
                <h2 class="section-title">Promo Code</h2>
                <div class="promo-section">
                    <input type="text" class="promo-input" placeholder="Enter promo code">
                    <button class="promo-btn">Apply</button>
                </div>
            </div>-->
        </section>
        <!-- Left Column: order-details -->
        <!-- Right Column: Order Summary -->
        <aside class="order-summary-section">
            <div class="order-summary-card">
                <h2>Order Summary</h2>

                <!-- Divider -->
                <div class="summary-divider"></div>

                <!-- Price Breakdown -->
                <div class="price-breakdown">
                    <div class="breakdown-row">
                        <span>Subtotal</span>
                        <span>@subTotal</span>
                    </div>
                    @if (vat.IsActive == true)
                    {
                        <div class="breakdown-row">
                            <span>@vat.Title @vat.Header</span>
                            <span>@vatedValue</span>
                        </div>
                    }
                    @if (delivery_charge.IsActive == true)
                    {
                        <div class="breakdown-row">
                            <span>@delivery_charge.Title</span>
                            <span>@delivery_charge.Header</span>
                        </div>
                    }
                    @if (gateway_charge.IsActive == true)
                    {
                        <div class="breakdown-row">
                            <span>@gateway_charge.Title</span>
                            <span>@gateway_charge.Header</span>
                        </div>
                    }
                    <!-- <div class="breakdown-row discount">
                        <span>Discount</span>
                        <span>-0.00</span>
                    </div> -->
                </div>

                <!-- Divider -->
                <div class="summary-divider"></div>

                <!-- Total -->
                <div class="order-total">
                    <span>Total</span>
                    <span class="total-amount">@grandTotal</span>
                </div>

                <!-- Checkout Button -->
                <button type="submit" class="checkout-btn">Place Order</button>

                <!-- Continue Shopping -->
                <button class="continue-shopping-btn" onclick="goToProducts()">Continue Shopping</button>

                <!-- Security Info -->
                <div class="security-info">
                    <p>🔒 Secure checkout powered by SSL</p>
                </div>
            </div>
        </aside>
        <!-- Right Column: Order Summary -->

    </main>
    <!-- Main Checkout Content -->
</form>
<!-- Checkout Form -->
<script>
    function clearCart(){
        location.href='/Home/CartClear';
    }

    function goToProducts(){
        location.href='/Home/Products';
    }
</script>
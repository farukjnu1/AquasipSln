        flex-direction: column;
        gap: 12px;
    }

    .shipping-option {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 16px;
        padding: 16px;
        border: 2px solid #ececec;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .shipping-option:hover {
            border-color: #4f46e5;
            background: #f9f8ff;
        }

        .shipping-option input[type="radio"] {
            cursor: pointer;
            width: 20px;
            height: 20px;
        }

    .option-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .option-name {
        font-weight: 500;
        color: #1d1d1d;
    }

    .option-time {
        font-size: 0.85rem;
        color: #666;
    }

    .option-price {
        font-weight: 600;
        color: #4f46e5;
    }

    /* ===== CHECKBOX & LABELS ===== */

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-weight: 500;
        margin-top: 16px;
    }

        .checkbox-label input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

    /* ===== PROMO CODE SECTION ===== */

    .promo-section {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
    }

    .promo-input {
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 1rem;

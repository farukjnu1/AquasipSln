@model IEnumerable<Aquasip.Models.PageVM>
@using Aquasip.Utilities
@{
    var pRepo = new Aquasip.Repositories.PageRepository(WebsiteConfig.ConnectionString);
    var pcRepo = new Aquasip.Repositories.PageContentRepository(WebsiteConfig.ConnectionString);

    var layoutPage = pRepo.GetBySlug("layout");
    layoutPage.PageContents = pcRepo.GetBySlugPage("layout");

    var oLogo = layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "logo").First();

    ViewData["Title"] = "AquaSip | Home";
    var oHome = Model.Where(x => x.Slug == "home").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "home").First();

    var listSlide = oHome.PageContents.Where(x => x.SlugPageContent == "slides" && x.IsActive == true).ToList();
    var oSlide0 = listSlide.Count() > 0 ? listSlide[0] : new PageContentVM();
    var oSlide1 = listSlide.Count() > 1 ? listSlide[1] : new PageContentVM();

    var oService = Model.Where(x => x.Slug == "services").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "services").First();
    var ourService = oService.PageContents.Where(x => x.SlugPageContent == "our_services").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oService.PageContents.Where(x => x.SlugPageContent == "our_services").First();
    var listService = oService.PageContents.Where(x => x.SlugPageContent == "services" && Convert.ToString(x.Description).ToLower() == "home").Take(8).ToList();

    var oAbout = Model.Where(x => x.Slug == "about").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "about").First();
    var aboutUs = oAbout.PageContents.Where(x => x.SlugPageContent == "about").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oAbout.PageContents.Where(x => x.SlugPageContent == "about").First();
    var aboutImg = oAbout.PageContents.Where(x => x.SlugPageContent == "about_img").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oAbout.PageContents.Where(x => x.SlugPageContent == "about_img").First();
    var listAbout = oAbout.PageContents.Where(x => x.SlugPageContent == "abouts").ToList();

    var oOurTeam = Model.Where(x => x.Slug == "our_team").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "our_team").First();
    var ourTeam = oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_team").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_team").First();
    var listOurTeam = oOurTeam.PageContents.Where(x => x.SlugPageContent == "our_teams" && Convert.ToString(x.Description).ToLower() == "home").Take(4).ToList();

    var oTestimonial = Model.Where(x => x.Slug == "testimonial").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "testimonial").First();
    var testimonial = oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonial").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonial").First();
    var listTestimonial = oTestimonial.PageContents.Where(x => x.SlugPageContent == "testimonials" && Convert.ToString(x.Description).ToLower() == "home").ToList();

    var oOurBlog = Model.Where(x => x.Slug == "our_blog").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "our_blog").First();
    var ourBlog = oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blog").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM() :
                        oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blog").First();
    var listOurBlog = oOurBlog.PageContents.Where(x => x.SlugPageContent == "our_blogs").OrderByDescending(y => y.UploadedAt).Take(3).ToList();

    //var layoutPage = Model.Where(x => x.Slug == "layout").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "layout").First();

    var oPhone = layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.SlugPageContent == "phone").First();

    var websiteName = layoutPage.SiteSettings.Where(x => x.SettingKey == "website-name").FirstOrDefault() == null ? new SiteSettingVM() : layoutPage.SiteSettings.Where(x => x.SettingKey == "website-name").First();

    //var oHome = Model.Where(x => x.Slug == "home").FirstOrDefault() == null ? new PageVM() : Model.Where(x => x.Slug == "home").First();
    var listProduct = oHome.Products;
}

<!-- Navbar & Hero Start -->
<div class="container-fluid position-relative p-0">
    <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
        <a href="/" class="navbar-brand p-0">
            @if (oLogo.IsActive == true)
            {
                <h1 class="text-primary m-0"><img src="@oLogo.FilePath" /></h1>
            }
            else
            {
                <h1 class="text-primary m-0">YOUR-LOGO</h1>
            }
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="fa fa-bars"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto py-0">
                <a href="/" class="nav-item nav-link">Home</a>
                <a href="/Home/Products" class="nav-item nav-link active">Products</a>
                <a href="javascript:void(0);" class="nav-item nav-link">Specification</a>
                <a href="/Home/Cart" class="nav-item nav-link ">Shopping Cart</a>
                <a href="/Home/Gallery" class="nav-item nav-link">Gallery</a>
                <a href="/Home/Contact" class="nav-item nav-link">Contact</a>
                <a href="/Home/Review" class="nav-item nav-link">Review</a>
                <a href="/Home/Faq" class="nav-item nav-link">FAQ</a>
            </div>
            <div class="d-none d-xl-flex me-3">
                <div class="d-flex flex-column pe-3 border-end border-primary">
                    <span class="text-body">Get Free Delivery</span>
                    <a href="tel:@oPhone.Header"><span class="text-primary">Free: @oPhone.Header</span></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header Start -->
    <div class="container-fluid bg-breadcrumb">
        <div class="container text-center py-5" style="max-width: 900px;">
            <h4 class="text-white display-4 mb-4 wow fadeInDown" data-wow-delay="0.1s">Products</h4>
            <ol class="breadcrumb d-flex justify-content-center mb-0 wow fadeInDown" data-wow-delay="0.3s">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active text-primary">Products</li>
            </ol>
        </div>
    </div>
    <!-- Header End -->
</div>
<!-- Navbar & Hero End -->

<!-- Products Start -->
<div class="container-fluid product py-5">
    <div class="container py-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px;">
            <h4 class="text-uppercase text-primary">Our Products</h4>
            <h1 class="display-3 text-capitalize mb-3">We Deliver Best Quality Bottle Packs.</h1>
        </div>
        <div class="row g-4 justify-content-center">
            @for (var i = 0; i < listProduct.Count; i++)
            {
                var item = listProduct[i];
                int dela = (i + 1) * 20;
                double delas = dela / 100.0;
                string delays = delas.ToString() + "s";
                string FilePath = item.ListProductMedia.Count > 0 ? item.ListProductMedia[0].FilePath : "";
                <div class="col-lg-6 col-xl-4 wow fadeInUp" data-wow-delay="@delays">
                    <div class="product-item">
                        <img src="@FilePath" class="img-fluid w-100 rounded-top" alt="Image" />
                        <div class="product-content bg-light text-center rounded-bottom p-4">
                            <p>@item.ProductCode</p>
                            <a href="#" class="h4 d-inline-block mb-3">@item.ProductName</a>
                            <p class="fs-4 text-primary mb-3">BDT. @item.Price</p>
                            <a href="/Home/Spec?id=@item.ProductId" class="btn btn-secondary rounded-pill py-2 px-4 m-1">Spec</a>
                            <a href="/Home/Spec?id=@item.ProductId" class="btn btn-primary rounded-pill py-2 px-4 m-1">Order Now</a>
                            <a href="/Home/Review?id=@item.ProductId" class="btn btn-warning rounded-pill py-2 px-4 m-1">Leave Review</a>
                        </div>
                        <div class="product-content bg-light text-center rounded-bottom p-4">
                            @if (item.AverageRating < 2)
                            {
                                var starts = "Review: ⭐";
                                @starts
                            }
                            else if (item.AverageRating < 3)
                            {
                                var starts = "Review: ⭐⭐";
                                @starts
                            }
                            else if (item.AverageRating < 4)
                            {
                                var starts = "Review: ⭐⭐⭐";
                                @starts
                            }
                            else if (item.AverageRating < 5)
                            {
                                var starts = "Review: ⭐⭐⭐⭐";
                                @starts
                            }
                            else if (item.AverageRating < 6)
                            {
                                var starts = "Review: ⭐⭐⭐⭐⭐";
                                @starts
                            }

                        </div>
                    </div>
                </div>
            }


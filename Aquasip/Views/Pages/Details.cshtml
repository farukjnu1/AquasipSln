@model IEnumerable<Aquasip.Models.PageVM>
@{
    ViewData["Title"] = "Page";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    //Layout = "~/Views/Shared/_LayoutReview.cshtml";

    var oPage = Model == null ? new PageVM() : Model.First();
    int serial = 0;
}

<div class="container-fluid">
    <h3 style="padding-top:10px">Page Detail of</h3>
    <h3 class="text-danger">@oPage.Title </h3>
    <a href="/Pages">Back to List</a>
    <hr />
    <div class="table-responsive">
        <table class="table table-bordered table-responsive" style="table-layout:fixed;width:100%">
            <tr>
                <th>#</th>
                <th>Status</th>
                <th>Slug</th>
                <th>Title</th>
                <th>Header</th>
                <th>Body</th>
                <th>Footer</th>
                <th>Attachment</th>
            </tr>
            @foreach (var item in oPage.PageContents.Where(x => x.SlugPageContent != "quick_links"
            && x.SlugPageContent != "our_services"
            && x.SlugPageContent != "copy_right"
            && x.SlugPageContent != "designed_by"))
            {
                serial += 1;
                string status = item.IsActive == true ? "Enabled" : "Disabled";
                string statusCss = item.IsActive == true ? "success" : "danger";
                <tr>
                    <td>@serial</td>
                    <td>
                        <div class="badge bg-@statusCss">@status</div>
                    </td>
                    <td>
                        @item.SlugPageContent
                    </td>
                    <td style="overflow-wrap:break-word">
                        <a href="/PageContents/Edit/@item.PageContentId">@item.Title</a>
                    </td>
                    <td style="overflow-wrap:break-word">@item.Header</td>
                    <td style="overflow-wrap:break-word">@item.Body</td>
                    <td style="overflow-wrap:break-word">@item.Footer</td>
                    <td style="overflow-wrap:break-word"><img src="@item.FilePath" style="width:150px" /></td>
                </tr>
            }
        </table>
    </div>
    
</div>

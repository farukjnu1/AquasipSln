@model Aquasip.EF.SalesReturn

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var oSalesOrder = ViewData["SalesOrder"] as Aquasip.EF.SalesOrder;
    var listSalesReturnDetail = ViewData["SalesReturnDetails"] as List<Aquasip.EF.SalesReturnDetail>;
}

<h3>Create Sales Return</h3>
<div class="row">
    <div class="col-md-4">
        <hr />
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* <input type="hidden" asp-for="PurchaseStateId" value="1" /> *@
            <input type="hidden" asp-for="SalesOrderId" value="@oSalesOrder.OrderId" />
            <input type="hidden" asp-for="IsActive" value="true" />
            @* <div class="form-group">
                <label asp-for="Ponumber" class="control-label"></label>
                <input asp-for="Ponumber" class="form-control" />
                <span asp-validation-for="Ponumber" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="ReturnDate" class="control-label"></label>
                <input asp-for="ReturnDate" class="form-control" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="CustomerId" value="@oSalesOrder.CustomerId" />
                <label for="FullName" class="control-label"></label>
                <input type="text" id="FullName" class="form-control" value="@oSalesOrder.Customer.FullName" readonly />
            </div>
            @* <div class="form-group">
                <label asp-for="SubTotal" class="control-label"></label>
                <input asp-for="SubTotal" class="form-control" />
                <span asp-validation-for="SubTotal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountAmount" class="control-label"></label>
                <input asp-for="DiscountAmount" class="form-control" />
                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TaxAmount" class="control-label"></label>
                <input asp-for="TaxAmount" class="form-control" />
                <span asp-validation-for="TaxAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalAmount" class="control-label"></label>
                <input asp-for="TotalAmount" class="form-control" />
                <span asp-validation-for="TotalAmount" class="text-danger"></span>
            </div> *@
            @* <div class="form-group">
                <label asp-for="IsActive" class="control-label"></label>
                <input asp-for="IsActive" class="form-control" />
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div> *@
            <div class="form-group pt-3">
                <input type="submit" value="Add Sales Return Items" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div class="col-md-8">
        <h5>Order Details :: 
            OrderNum: <span class="text-success">@oSalesOrder.OrderNumber</span> 
            Date: <span class="text-success">@oSalesOrder.OrderDate</span>
        </h5>
        <hr />
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>UnitPrice</th>
                    <th>Qty</th>
                    <th style="text-align:right">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in oSalesOrder.SalesOrderDetails)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>
                        <td>@item.UnitPrice</td>
                        <td>@item.Qty</td>
                        <td align="right">@item.TotalPrice</td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>


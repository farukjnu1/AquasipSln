@model Aquasip.Models.SalesReturnVM

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    //var listPurchaseOrderDetail = ViewData["PurchaseOrderDetails"] as List<Aquasip.EF.PurchaseOrderDetail>;
    //decimal totalPaidAmount = 0;
    string? paymentStatus = "undefined";
    //totalPaidAmount = Model.SupplierPayments.Where(y => y.PaymentStatusId == 2).Sum(x => x.PaidAmount);
    //paymentStatus = totalPaidAmount < Model.TotalAmount ? "DUE" : "PAID";
    //string paymentStatusColor = totalPaidAmount < Model.TotalAmount ? "badge bg-danger" : "badge bg-success";
}

<h3>Sales Return for Stocks</h3>

<div class="row">
    <div class="col-md-6">
        <h4>Summery</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ReturnNumber)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ReturnNumber)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.ReturnDate)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.ReturnDate)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.TotalAmount)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.TotalAmount)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.IsActive)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.IsActive)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Customer)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Customer.FullName)
            </dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h4>Details</h4>
        <hr />
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>UnitCost</th>
                    <th>Qty</th>
                    <th style="text-align:right">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SalesReturnDetails)
                {
                    <tr>
                        <td>@item.Product.ProductName</td>
                        <td>@item.UnitPrice</td>
                        <td>@item.Qty</td>
                        <td align="right">@item.LineTotal</td>
                        <td>         
                            @if (item.IsStockUpdated == true)
                            {
                                <a href="javascript:void(0)" title="Returned">Returned</a>
                            }
                            else
                            {
                                <a href="/StockTransactions/SalesReturnDetail?id=@item.SalesReturnDetailId&referenceToken=@item.ReferenceToken&transactionType=@item.TransactionTypeToken" title="Remove from Stocks">Remove from Stocks</a>
                            }
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        
    </div>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.SalesReturnId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

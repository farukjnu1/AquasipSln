@model IEnumerable<Aquasip.EF.PurchaseReturn>

@{
    ViewData["Title"] = "Purchase Returns";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var poNumber = (string?)ViewData["Ponumber"];
    var pageSize = (int?)ViewData["PageSize"];
    var listPurchaseOrder = ViewData["PurchaseOrders"] as List<Aquasip.EF.PurchaseOrder>;
}

<h3>Purchase Returns</h3>
@* 
<p>
    <a asp-action="Create">Create New</a>
</p> *@

<div class="row">
    <div class="col-md-3">
        <input type="hidden" id="strPoNumber" value="@poNumber" />
        <label for="poNumber" class="control-label">Purchase No.</label>
        <input type="text" id="poNumber" value="@poNumber" />
    </div>
    <div class="col-md-1">
        <input type="hidden" id="nPageSize" value="@pageSize" />
        <label for="PageSize" class="control-label">Row</label>
        <select id="PageSize">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="500">500</option>
        </select>
    </div>
    <div class="col-md-1">
        <button onclick="search()">Search</button>
    </div>
    <div class="col-md-7">
        <table class="table">
            @if (listPurchaseOrder.Count > 0)
            {
                <thead>
                    <tr>
                        <th>PO No.</th>
                        <th>Date</th>
                        <th>Supplier</th>
                        <th>#</th>
                    </tr>
                </thead>
            }
            <tbody>
                @foreach (var item in listPurchaseOrder)
                {
                    <tr>
                        <td>@item.Ponumber</td>
                        <td>@item.Podate</td>
                        <td>@item.Supplier.SupplierName</td>
                        <td><a asp-action="Create" asp-route-id="@item.PurchaseOrderId">Create</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                Return No.
            </th>
            <th>
                Return Date
            </th>
            <th>
                Purchase No.
            </th>
            <th>
                Supplier
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ReturnNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReturnDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PurchaseOrder.Ponumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Supplier.SupplierName)
            </td>
            
            <td>
                <a asp-action="Edit" asp-route-id="@item.PurchaseReturnId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PurchaseReturnId">Stocks</a>
                @* <a asp-action="Delete" asp-route-id="@item.PurchaseOrderId">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>

<script>
    // Equivalent to jQuery $(document).ready()
    document.addEventListener("DOMContentLoaded", function () {
        console.log("Document is ready!");
        setSearchValues();
    });
    function setSearchValues(){
        var nPageSize = document.getElementById('nPageSize').value;
        document.getElementById('PageSize').value = nPageSize;
        var poNumber = document.getElementById('strPoNumber').value;
        document.getElementById('poNumber').value = poNumber;
    }
    function search(){
        var poNumber = document.getElementById('poNumber').value;
        var PageSize = document.getElementById('PageSize').value;
        location.href = '/PurchaseReturns/Index?poNumber=' + poNumber + '&PageSize=' + PageSize;
    }
</script>

@model IEnumerable<Aquasip.EF.SalesReturn>

@{
    ViewData["Title"] = "Sales Returns";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var orderNumber = (string?)ViewData["OrderNumber"];
    var pageSize = (int?)ViewData["PageSize"];
    var listSalesOrder = ViewData["SalesOrders"] as List<Aquasip.EF.SalesOrder>;
}

<h3>Sales Returns</h3>
@* 
<p>
    <a asp-action="Create">Create New</a>
</p> *@

<div class="row">
    <div class="col-md-3">
        <input type="hidden" id="strOrderNum" value="@orderNumber" />
        <label for="orderNum" class="control-label">Order Num.</label>
        <input type="text" id="orderNum" value="@orderNumber" />
    </div>
    <div class="col-md-1">
        <input type="hidden" id="nPageSize" value="@pageSize" />
        <label for="PageSize" class="control-label">Row</label>
        <select id="PageSize">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="500">500</option>
        </select>
    </div>
    <div class="col-md-1">
        <button onclick="search()">Search</button>
    </div>
    <div class="col-md-7">
        <table class="table">
            @if (listSalesOrder.Count > 0)
            {
                <thead>
                    <tr>
                        <th>Order Num</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>#</th>
                    </tr>
                </thead>
            }
            <tbody>
                @foreach (var item in listSalesOrder)
                {
                    <tr>
                        <td>@item.OrderNumber</td>
                        <td>@item.OrderDate</td>
                        <td>@item.Customer.FullName</td>
                        <td><a asp-action="Create" asp-route-id="@item.OrderId">Create</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                Return No.
            </th>
            <th>
                Return Date
            </th>
            <th>
                Order No.
            </th>
            <th>
                Customer
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ReturnNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReturnDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SalesOrder.OrderNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.FullName)
            </td>
            
            <td>
                    <a asp-action="Edit" asp-route-id="@item.SalesReturnId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.SalesReturnId">Stocks</a>
                @* <a asp-action="Delete" asp-route-id="@item.PurchaseOrderId">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>

<script>
    // Equivalent to jQuery $(document).ready()
    document.addEventListener("DOMContentLoaded", function () {
        console.log("Document is ready!");
        setSearchValues();
    });
    function setSearchValues(){
        var nPageSize = document.getElementById('nPageSize').value;
        document.getElementById('PageSize').value = nPageSize;
        var poNumber = document.getElementById('strPoNumber').value;
        document.getElementById('poNumber').value = poNumber;
    }
    function search(){
        var orderNum = document.getElementById('orderNum').value;
        var PageSize = document.getElementById('PageSize').value;
        location.href = '/SalesReturns/Index?orderNum=' + orderNum + '&PageSize=' + PageSize;
    }
</script>

                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Sign-in</a>
                <div class="dropdown-menu m-0">
                    <a href="/Home/Signin" class="dropdown-item">Sign-in as customer</a>
                </div>
            </div>
        }
        else
        {
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">@FullName</a>

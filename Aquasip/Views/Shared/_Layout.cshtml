@using Aquasip.Utilities
@{
    var pageRepo = new Aquasip.Repositories.PageRepository(WebsiteConfig.ConnectionString);
    var pageContentRepo = new Aquasip.Repositories.PageContentRepository(WebsiteConfig.ConnectionString);
    var menuRepo = new Aquasip.Repositories.MenuRepository(WebsiteConfig.ConnectionString);
    
    var layoutPage = pageRepo.GetBySlug("layout");
    layoutPage.PageContents = pageContentRepo.GetBySlugPage("layout");

    var listMenu = menuRepo.GetAll();
    string? urL = Context.Session.GetString("urL");

    // var appointment = (from x in listMenu where x.Slug == "appointment" select x).FirstOrDefault() == null ? new MenuVM()
    //                     : (from x in listMenu where x.Slug == "appointment" select x).First();

    var oLocation = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "location").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "location").First();

    var oPhone = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "phone").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "phone").First();

    var oEmail = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "email").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "email").First();

    var oFacebook = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "facebook").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "facebook").First();

    var oTwitter = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "twitter").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "twitter").First();

    var oInstagram = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "instagram").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "instagram").First();

    var oLinkedin = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "linkedin").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "linkedin").First();

    var oLogo = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "logo").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "logo").First();

    var listQuickLink = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "quick_links").ToList();
    var listOurService = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "our_services").ToList();

    var oAddress = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "address").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "address").First();

    var oEmail2 = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "email_2").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "email_2").First();

    var oWhatsapp = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "whatsapp").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "whatsapp").First();

    var oCopyRight = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "copy_right").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "copy_right").First();

    var oQuickLink = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "quick_links").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "quick_links").First();

    var oBusinessHour = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "business_hours").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "business_hours").First();

    var oContactInfo = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "contact_info").FirstOrDefault() == null ? new Aquasip.Models.PageContentVM()
    : layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "contact_info").First();

    var listDesignedBy = layoutPage.PageContents.Where(x => x.IsActive == true && x.SlugPageContent == "designed_by").ToList();

    var message = TempData["message"] as string;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>AquaSip</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wdth,wght@0,75..100,300..800;1,75..100,300..800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet">
</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->
    
    <div id="contentPlaceHolder">
        @RenderBody()
    </div>

    @if (message != null)
    {
        TempData["message"] = null;
        <script>
            alert('@message');
        </script>
    }

    <!-- Footer Start -->
    <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.2s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="footer-item d-flex flex-column">
                        @if (oLogo.IsActive == true)
                        {
                            <h4 class="text-white mb-4"><img src="@oLogo.FilePath" style="width: 135px" /></h4>
                            <p>
                                @oLogo.Body
                            </p>
                        }
                        else
                        {
                            <h4 class="text-white mb-4">YOUR-LOGO</h4>
                            <p></p>
                        }
                        <div class="d-flex align-items-center">
                            <i class="fas fa-share fa-2x text-white me-2"></i>
                            @if (oFacebook.IsActive == true)
                            {
                                <a class="btn-square btn btn-primary text-white rounded-circle mx-1" href="@oFacebook.Header" target="_blank"><i class="fab fa-facebook-f"></i></a>
                            }
                            @if (oTwitter.IsActive == true)
                            {
                                <a class="btn-square btn btn-primary text-white rounded-circle mx-1" href="@oTwitter.Header" target="_blank"><i class="fab fa-twitter"></i></a>
                            }
                            @if (oInstagram.IsActive == true)
                            {
                                <a class="btn-square btn btn-primary text-white rounded-circle mx-1" href="@oInstagram.Header" target="_blank"><i class="fab fa-instagram"></i></a>
                            }
                            @if (oLinkedin.IsActive == true)
                            {
                                <a class="btn-square btn btn-primary text-white rounded-circle mx-1" href="@oLinkedin.Header" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="footer-item d-flex flex-column">
                        <h4 class="mb-4 text-white">Quick Links</h4>
                        @foreach (var item in listQuickLink)
                        {
                            if (item.IsActive == true)
                            {
                                <a href="@item.Header"><i class="fas fa-angle-right me-2"></i> @item.Title</a>
                            }
                        }
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="footer-item d-flex flex-column">
                        <h4 class="mb-4 text-white">@Html.Raw(oBusinessHour.Title)</h4>
                        @Html.Raw(oBusinessHour.Body)
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-3">
                    <div class="footer-item d-flex flex-column">
                        <h4 class="mb-4 text-white">Contact Info</h4>
                        @if (oAddress.IsActive == true)
                        {
                            <a href="javascript:void(0)"><i class="fa fa-map-marker-alt me-2"></i> @oAddress.Header</a>
                        }
                        @if (oEmail.IsActive == true)
                        {
                            <a href="@oEmail.Header"><i class="fas fa-envelope me-2"></i> @oEmail.Body</a>
                        }
                        @if (oEmail2.IsActive == true)
                        {
                            <a href="@oEmail2.Header"><i class="fas fa-envelope me-2"></i> @oEmail2.Body</a>
                        }
                        @if (oPhone.IsActive == true)
                        {
                            <a href="@oPhone.Header"><i class="fas fa-phone me-2"></i> @oPhone.Body</a>
                        }
                        @if (oWhatsapp.IsActive == true)
                        {
                            <a href="@oWhatsapp.Header" class="mb-3"><i class="fab fa-whatsapp me-2"></i> @oWhatsapp.Body</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer End -->

    <!-- Copyright Start -->
    <div class="container-fluid copyright py-4">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start mb-md-0">
                    @if (oCopyRight.IsActive == true)
                    {
                        <span class="text-white"><a href="@oCopyRight.Header" target="_blank"><i class="fas fa-copyright text-light me-2"></i>@oCopyRight.Title</a>, @oCopyRight.Body</span>
                    }
                </div>
                <div class="col-md-6 text-center text-md-end text-white">
                    <span>Designed By</span>
                    @for (var i = 0; i < listDesignedBy.Count; i++)
                    {
                        if (i > 0)
                        {
                            <span> & </span>
                        }
                        <a class="border-bottom" href="@listDesignedBy[i].Header" target="_blank">@listDesignedBy[i].Body</a>
                    }
                </div>
            </div>
        </div>
    </div>
    <!-- Copyright End -->

    <!-- Back to Top -->
    <a href="#" class="btn btn-secondary btn-lg-square rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/js/main.js"></script>

</body>

</html>